#!/bin/sh
# Runs this branch's attribution check (else main's, when core.hooksPath is absolute), then runs
# this branch's scripts/check against the working tree when pushing commits.
set -eu
top=$(git rev-parse --show-toplevel)
script=$top/scripts/no-ai-attribution
[ -x "$script" ] || script=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/scripts/no-ai-attribution
[ -x "$script" ] || { echo "scripts/no-ai-attribution is missing here and in the main checkout. Pull main." >&2; exit 1; }
refs=$(cat)
[ -n "$refs" ] || exit 0
printf '%s\n' "$refs" | "$script" pre-push "$@"
if [ -x "$top/scripts/check" ] && printf '%s\n' "$refs" | awk 'NF >= 2 && $2 !~ /^0+$/ { found = 1 } END { exit !found }'; then
  exec "$top/scripts/check"
fi
