#!/bin/sh
# Tests that scripts/check accepts a clean repository and rejects violations in each gate.
# Usage: tests/check
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/test-check.XXXXXX")
work=$(cd "$work" && pwd -P)
trap 'rm -rf "$work"' EXIT
trap 'exit 130' HUP INT TERM

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
MISE_STATE_DIR=$work/mise-state
export MISE_STATE_DIR
mkdir -p "$MISE_STATE_DIR"

copy=$work/repo
mkdir -p "$copy"
python3 -I -B - "$repo" "$copy" <<'PY'
import os, shutil, subprocess, sys

src, dst = sys.argv[1], sys.argv[2]
raw = subprocess.check_output(
    ["git", "-C", src, "-c", "core.excludesFile=/dev/null", "-c", "core.quotePath=false", "ls-files", "-z", "--cached", "--others", "--exclude-standard"]
)
for rel in raw.decode("utf-8").split("\0"):
    if not rel:
        continue
    s = os.path.join(src, rel)
    if os.path.isfile(s) and not os.path.islink(s):
        d = os.path.join(dst, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.copy2(s, d)
PY
git -C "$copy" init -q -b main
git -C "$copy" config user.name test
git -C "$copy" config user.email test@example.com
git -C "$copy" config commit.gpgsign false
git -C "$copy" add -A
git -C "$copy" commit -q -m 'chore: baseline'

failed=0
fail() {
  echo "FAIL: $*" >&2
  sed 's/^/  | /' "$work/out" >&2
  failed=1
}

rewrite() { # <sed script> <file>
  sed "$1" "$2" >"$work/rewrite.tmp"
  mv "$work/rewrite.tmp" "$2"
}

reset_copy() {
  git -C "$copy" reset -q --hard HEAD
  git -C "$copy" clean -q -fdx
}

run_check() {
  status=0
  MISE_TRUSTED_CONFIG_PATHS=$copy "$@" "$copy/scripts/check" >"$work/out" 2>&1 || status=$?
}

expect_green() {
  name=$1
  shift
  run_check env "$@"
  if [ "$status" = 0 ]; then
    echo "ok   $name"
  else
    fail "$name: exited $status, wanted 0"
  fi
  reset_copy
}

expect_red() { # <name> <expected step substring> <expected message substring> [env args...]
  name=$1 want_step=$2 want_msg=$3
  shift 3
  run_check env "$@"
  last_step=$(sed -n 's/^==> //p' "$work/out" | tail -n 1)
  if [ "$status" = 0 ]; then
    fail "$name: passed, wanted failure in '$want_step'"
  elif ! printf '%s\n' "$last_step" | grep -qF -- "$want_step"; then
    fail "$name: failed in '$last_step', wanted '$want_step'"
  elif ! grep -qF -- "$want_msg" "$work/out"; then
    fail "$name: output lacks '$want_msg'"
  else
    echo "ok   $name"
  fi
  reset_copy
}

# Verify caller git author/config env vars cannot poison child tests, and CLI args are rejected.
bot_id=$(cat "$repo/tests/attribution/git/bot-author.txt")
expect_green 'clean repository passes even with caller bot GIT_AUTHOR_NAME' \
  GIT_AUTHOR_NAME="${bot_id% <*}" GIT_COMMITTER_NAME="${bot_id% <*}"

status=0
MISE_TRUSTED_CONFIG_PATHS=$copy "$copy/scripts/check" --unexpected >"$work/out" 2>&1 || status=$?
if [ "$status" = 2 ]; then
  echo 'ok   unexpected CLI argument exits 2'
else
  fail "unexpected CLI argument exited $status, wanted 2"
fi

printf 'shellcheck 0.11.0\n' >"$copy/.tool-versions"
expect_red 'extra mise config is rejected' 'Pinned tools' 'only mise.toml configures this repository' MISE_ENV=ci

mkdir "$work/shadow"
printf '#!/bin/sh\nexit 0\n' >"$work/shadow/shellcheck"
chmod +x "$work/shadow/shellcheck"
expect_red 'shadowed PATH tool under forged SCRIPTS_CHECK_UNDER_MISE is rejected' 'Pinned tools' 'not mise'"'"'s' \
  SCRIPTS_CHECK_UNDER_MISE="$copy" \
  MISE_GLOBAL_CONFIG_FILE=/dev/null/no-global-config.toml \
  MISE_SYSTEM_CONFIG_FILE=/dev/null/no-system-config.toml \
  MISE_CEILING_PATHS="$(dirname "$copy")" \
  PATH="$work/shadow:$PATH"

rewrite 's/version = "0\.11\.0"/version = "0.10.0"/' "$copy/mise.lock"
expect_red 'mise.lock version drift is rejected' 'Pinned tools' 'mise.lock lacks shellcheck 0.11.0'

rewrite 's/platforms\.linux-x64/platforms.freebsd-x64/' "$copy/mise.lock"
expect_red 'missing linux-x64 platform in mise.lock is rejected' 'Pinned tools' 'mise.lock lacks linux-x64'

rewrite 's/version: "2026\.11\.8"/version: "2025.1.0"/' "$copy/.github/workflows/check.yml"
expect_red 'workflow mise version drift is rejected' 'Pinned tools' 'mise version mismatch'

printf '#!/bin/sh\necho hi\n' >"$copy/scripts/bad name.sh"
expect_red 'whitespace in path is rejected' 'Git-visible file names' 'ASCII paths without spaces, control characters or double quotes'

printf '#!/bin/sh\necho hi\n' >"$copy/scripts/bad\"quote.sh"
expect_red 'interior quote in path is rejected' 'Git-visible file names' 'ASCII paths without spaces, control characters or double quotes'

ln -s README.md "$copy/LINK.md"
expect_red 'symlink in repository is rejected' 'Git-visible file names' 'Symlinks are not allowed'

printf '# Upper\n' >"$copy/UPPER.MD"
expect_red 'uppercase extension is rejected' 'Git-visible file names' 'lower-case file extension'

printf '#!/usr/bin/env zsh\necho hi\n' >"$copy/scripts/bad-zsh"
expect_red 'non-allowed shebang is rejected' 'Git-visible file names' 'Unsupported shebang'

printf 'echo hi\n' >"$copy/scripts/no-shebang"
chmod +x "$copy/scripts/no-shebang"
expect_red 'shebang-less executable file is rejected' 'Git-visible file names' 'Executable file lacks a shebang'

# shellcheck disable=SC2016 # literal $unquoted_var with space after #! for shellcheck to flag
printf '#! /bin/sh\necho $unquoted_var\n' >"$copy/scripts/bad-shell"
chmod +x "$copy/scripts/bad-shell"
expect_red 'shellcheck violation is rejected even when SHELLCHECK_OPTS is set' 'Shell scripts' 'SC2086' SHELLCHECK_OPTS='-e SC2086'

# shellcheck disable=SC2016 # literal $unquoted_tmpl for shellcheck to flag in check.tmpl
printf '\necho $unquoted_tmpl\n' >>"$copy/skills/scaffold/scaffold-go/template/scripts/check.tmpl"
expect_red 'scaffold check.tmpl shellcheck violation is rejected' 'Shell scripts' 'SC2086'

mkdir -p "$copy/.github"
printf 'self-hosted-runner:\n  labels: [bogus-runner]\n' >"$copy/.github/actionlint.yaml"
printf 'name: bad\non: [push]\njobs:\n  broken:\n    runs-on: bogus-runner\n    steps:\n      - run: true\n' >"$copy/.github/workflows/bad.yml"
expect_red 'invalid workflow cannot be silenced by .github/actionlint.yaml' 'Workflows' 'bogus-runner'

rewrite 's/perf|revert/revert/' "$copy/.github/workflows/title.yml"
expect_red 'title pattern drift is rejected' 'Workflows' 'different conventional-commit patterns'

printf 'sub broken {\n' >"$copy/scripts/bad.pl"
expect_red 'perl syntax error is rejected' 'Perl and Python scripts' 'syntax error'

printf 'def broken(:\n    pass\n' >"$copy/scripts/bad.py"
expect_red 'python syntax error is rejected' 'Perl and Python scripts' 'SyntaxError'

printf '\nSee [missing][ref].\n\n[ref]: skills/pull-request/github.md\n' >>"$copy/README.md"
expect_red 'wrong-case or missing reference markdown link is rejected' 'Markdown links' 'broken link target'

printf '\n[![badge](no-such-badge.svg)](README.md)\n' >>"$copy/README.md"
expect_red 'broken image inside linked image is rejected' 'Markdown links' 'broken link target'

printf '\nSee [dangling][missing-ref].\n' >>"$copy/README.md"
expect_red 'undefined markdown reference link is rejected' 'Markdown links' 'undefined link reference'

# shellcheck disable=SC2016 # literal backticks in Markdown test input
printf '\n- item\n     ```sh\n     echo [ok](no-such.md)\n     ```\n> ```markdown\n> [quoted](no-such.md)\n> ```\n[a]<!-- c -->(no-such.md)\n```inline``` text\n\nSee [anchor](README.md#no-such-heading).\n' >>"$copy/AGENTS.md"
expect_red 'missing markdown heading anchor after inline triple backticks is rejected' 'Markdown links' 'missing heading'
! grep -qF 'no-such.md' "$work/out" || fail 'fenced or comment-split bracket treated as live link'

printf '\n<!-- drift -->\n' >>"$copy/skills/scaffold/_shared/AGENTS.tail.md"
expect_red 'scaffold shared drift is rejected' 'Scaffold shared files' 'Out of sync with skills/scaffold/_shared'

cat "$copy/tests/attribution/blocked/trailer.txt" >"$copy/tests/attribution/allowed/bad.txt"
expect_red 'failing attribution test is rejected in Tests step' 'Tests' 'Some attribution tests failed'

# Verify .githooks/pre-push: older branch, empty push, attribution block, subdir failure,
# detached-worktree green push, tag push, and --delete.
hook_dir=$work/prepush
git init -q --bare -b main "$hook_dir/origin.git"
git clone -q "$hook_dir/origin.git" "$hook_dir/clone" 2>/dev/null
git -C "$hook_dir/clone" config user.name 'Test User'
git -C "$hook_dir/clone" config user.email test@example.com
git -C "$hook_dir/clone" config commit.gpgsign false
mkdir -p "$hook_dir/clone/scripts" "$hook_dir/clone/.githooks" "$hook_dir/clone/sub"
cp "$repo/scripts/no-ai-attribution" "$hook_dir/clone/scripts/no-ai-attribution"
cp "$repo/.githooks/pre-push" "$hook_dir/clone/.githooks/pre-push"
chmod +x "$hook_dir/clone/scripts/no-ai-attribution" "$hook_dir/clone/.githooks/pre-push"
git -C "$hook_dir/clone" config core.hooksPath "$hook_dir/clone/.githooks"
printf 'base\n' >"$hook_dir/clone/sub/a.txt"
git -C "$hook_dir/clone" add -A
git -C "$hook_dir/clone" commit -q -m 'docs: initial'
if git -C "$hook_dir/clone" push -q origin main >"$work/out" 2>&1 &&
  git -C "$hook_dir/clone" push -q origin main >"$work/out" 2>&1; then
  echo 'ok   pre-push allows older branch and up-to-date empty push'
else
  fail 'pre-push rejected older branch or empty push'
fi
git -C "$hook_dir/clone" checkout -q -b bad-attr
printf 'attr\n' >"$hook_dir/clone/sub/a.txt"
git -C "$hook_dir/clone" commit -qam "$(cat "$repo/tests/attribution/git/trailer-message.txt")"
if git -C "$hook_dir/clone" push -q origin bad-attr >"$work/out" 2>&1; then
  fail 'pre-push allowed AI-attributed commit'
else
  echo 'ok   pre-push blocks AI-attributed commit'
fi
git -C "$hook_dir/clone" checkout -q main
printf '#!/bin/sh\necho HOOK_CHECK_RAN >&2\nexit 1\n' >"$hook_dir/clone/scripts/check"
chmod +x "$hook_dir/clone/scripts/check"
git -C "$hook_dir/clone" checkout -q -b topic
printf 'next\n' >"$hook_dir/clone/sub/a.txt"
git -C "$hook_dir/clone" commit -qam 'docs: topic'
if git -C "$hook_dir/clone/sub" push -q origin topic >"$work/out" 2>&1; then
  fail 'pre-push allowed subdirectory push when scripts/check failed'
elif ! grep -qF HOOK_CHECK_RAN "$work/out"; then
  fail 'pre-push from subdirectory failed without running scripts/check'
else
  echo 'ok   pre-push runs scripts/check on subdirectory commit push'
fi
git -C "$hook_dir/clone" tag v1.0.0
if git -C "$hook_dir/clone" push -q origin v1.0.0 >"$work/out" 2>&1; then
  echo 'ok   pre-push skips scripts/check on tag push'
else
  fail 'pre-push ran scripts/check on tag push'
fi
printf '#!/bin/sh\n[ "$#" -eq 0 ] && echo GREEN_CHECK_RAN >&2\n' >"$hook_dir/clone/scripts/check"
chmod +x "$hook_dir/clone/scripts/check"
git -C "$hook_dir/clone" add -A
git -C "$hook_dir/clone" commit -qm 'docs: green check'
git -C "$hook_dir/clone" worktree add -q --detach "$hook_dir/detached" HEAD
if git -C "$hook_dir/detached" push -q origin HEAD:refs/heads/topic >"$work/out" 2>&1 &&
  grep -qF GREEN_CHECK_RAN "$work/out"; then
  echo 'ok   pre-push passes on green detached-worktree branch push'
else
  fail 'pre-push failed on green detached-worktree branch push'
fi
git -C "$hook_dir/clone" worktree remove --force "$hook_dir/detached"
git -C "$hook_dir/clone" checkout -q main
printf '#!/bin/sh\nexit 1\n' >"$hook_dir/clone/scripts/check"
chmod +x "$hook_dir/clone/scripts/check"
if git -C "$hook_dir/clone" push -q origin --delete topic >"$work/out" 2>&1; then
  echo 'ok   pre-push skips scripts/check on branch deletion'
else
  fail 'pre-push ran scripts/check on branch deletion'
fi

[ "$failed" = 0 ] || { echo 'Some check tests failed.' >&2; exit 1; }
echo 'All check tests passed.'
