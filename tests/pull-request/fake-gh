#!/usr/bin/env python3
"""A stand-in for the gh commands that scripts/land-squash-stack runs, backed by a bare git repo.

State lives in $FAKE_GH_STATE/state.json:
  origin              path of the bare repo that plays GitHub
  deleteBranchOnMerge GitHub's delete-on-merge setting
  mergeQueue          the default branch has a merge queue (gh pr merge then only enqueues)
  githubStack         {"number": N} when the PRs belong to GitHub stack N, absent otherwise
  stackQueryError     a message: the stack query then fails with it on stderr and exit status 1
  prs                 {number: {title, body, headRefName, baseRefName, state, isDraft, checks,
                      blocked, onMerge}}; checks is a list of SUCCESS, FAILURE or PENDING,
                      annotations is an optional list of strings returned for each of that PR's
                      check runs, annotationsByCheck is an optional list of such lists, one per
                      entry of checks, and wins over annotations when present, blocked keeps mergeStateStatus BLOCKED, onMerge is a sh command
                      run in the state dir after the PR merges (ORIGIN is set), for example to
                      move main
Every call appends its arguments to $FAKE_GH_STATE/calls.
"""
import json
import os
import subprocess
import sys

STATE_DIR = os.environ["FAKE_GH_STATE"]
STATE_FILE = os.path.join(STATE_DIR, "state.json")
TRUNK = "main"


def load():
    with open(STATE_FILE) as f:
        return json.load(f)


def save(state):
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=1)


def git(state, *args, check=True):
    r = subprocess.run(["git", "-C", state["origin"], *args], capture_output=True, text=True, check=False)
    if check and r.returncode != 0:
        sys.exit(f"fake gh: git {' '.join(args)} failed: {r.stderr}")
    return r


def branches(state):
    r = git(state, "for-each-ref", "--format=%(objectname) %(refname:strip=2)", "refs/heads")
    return {name: oid for line in r.stdout.splitlines() if line for oid, name in [line.split(" ", 1)]}


def branch_oid(state, branch):
    r = git(state, "rev-parse", "-q", "--verify", f"refs/heads/{branch}", check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def sync(state):
    """Keeps refs/pull/<n>/head current, and closes PRs whose base or head branch is gone."""
    heads = branches(state)
    changed = False
    for n, pr in state["prs"].items():
        if pr["state"] != "OPEN":
            continue
        head = heads.get(pr["headRefName"])
        if head is None or pr["baseRefName"] not in heads:
            pr["state"] = "CLOSED"
            changed = True
            continue
        if pr.get("headRefOid") != head:
            pr["headRefOid"] = head
            git(state, "update-ref", f"refs/pull/{n}/head", head)
            changed = True
    return changed


def merge_tree(state, base, head):
    r = git(state, "merge-tree", "--write-tree", base, head, check=False)
    return r.stdout.split("\n")[0] if r.returncode == 0 else None


def contains(state, ancestor, descendant):
    return git(state, "merge-base", "--is-ancestor", ancestor, descendant, check=False).returncode == 0


def view(state, n, want=None):
    pr = state["prs"][n]
    out = dict(pr, number=int(n))
    out.setdefault("headRefOid", None)
    out.setdefault("mergeCommit", None)
    out["statusCheckRollup"] = [
        {"__typename": "CheckRun", "name": f"check{i}",
         "status": "IN_PROGRESS" if c == "PENDING" else "COMPLETED",
         "conclusion": "" if c == "PENDING" else c}
        for i, c in enumerate(pr.get("checks", ["SUCCESS"]))
    ]
    if want is not None and not ({"mergeable", "mergeStateStatus"} & want):
        return out
    if pr["state"] == "OPEN":
        base = branch_oid(state, pr["baseRefName"])
        clean = merge_tree(state, base, pr["headRefOid"]) is not None
        out["mergeable"] = "MERGEABLE" if clean else "CONFLICTING"
        checks = pr.get("checks", ["SUCCESS"])
        if not clean:
            status = "DIRTY"
        elif pr.get("isDraft"):
            status = "DRAFT"
        elif pr.get("blocked") or "PENDING" in checks:
            status = "BLOCKED"
        elif "FAILURE" in checks:
            status = "UNSTABLE"
        else:
            status = "CLEAN"
        out["mergeStateStatus"] = status
    else:
        out["mergeable"] = "UNKNOWN"
        out["mergeStateStatus"] = "UNKNOWN"
    return out


def check_runs_for(state, oid):
    runs = []
    for n, pr in state["prs"].items():
        if pr.get("headRefOid") != oid:
            continue
        for i, c in enumerate(pr.get("checks", ["SUCCESS"])):
            runs.append({"id": int(n) * 100 + i + 1, "conclusion": None if c == "PENDING" else c.lower()})
    return runs


def emit(value, fields, jq):
    if fields is not None and isinstance(value, dict):
        value = {k: value.get(k) for k in fields.split(",")}
    if jq is not None and isinstance(value, dict) and jq.startswith(".") and all(p.isidentifier() for p in jq[1:].split(".")):
        v = value
        for part in jq[1:].split("."):
            v = v.get(part) if isinstance(v, dict) else None
        if not isinstance(v, (dict, list)):
            print("true" if v is True else "false" if v is False else "" if v is None else v)
            return
    text = json.dumps(value)
    if jq is None:
        print(text)
        return
    r = subprocess.run(["jq", "-r", jq], input=text, capture_output=True, text=True, check=False)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode != 0:
        sys.exit(r.returncode)


def merge(state, n, opts):
    pr = state["prs"][n]
    if pr["state"] != "OPEN":
        sys.exit(f"Pull request #{n} is not open")
    if state.get("mergeQueue") or state.get("classicMergeQueue"):
        print(f"Pull request #{n} will be added to the merge queue for {TRUNK} when ready")
        return
    if opts.get("--match-head-commit") != pr["headRefOid"]:
        sys.exit(f"Pull request #{n} head moved")
    v = view(state, n)
    if pr["baseRefName"] != TRUNK or v["mergeStateStatus"] not in ("CLEAN", "UNSTABLE"):
        sys.exit(f"Pull request #{n} is not mergeable: {pr['baseRefName']} {v['mergeStateStatus']}")
    base = branch_oid(state, TRUNK)
    tree = merge_tree(state, base, pr["headRefOid"])
    if "--body-file" in opts or "--subject" in opts:
        with open(opts["--body-file"]) as f:
            message = opts["--subject"] + "\n\n" + f.read()
    elif state.get("squashMergeCommitMessage") == "BLANK":
        message = f"{pr['title']} (#{n})\n"
    else:
        message = f"raw squash of #{n}\n\n* commit body"
    commit = subprocess.run(
        ["git", "-C", state["origin"], "commit-tree", tree, "-p", base, "-F", "-"],
        input=message, capture_output=True, text=True, check=True).stdout.strip()
    git(state, "update-ref", f"refs/heads/{TRUNK}", commit)
    pr["state"] = "MERGED"
    pr["mergeCommit"] = {"oid": commit}
    if state.get("deleteBranchOnMerge"):
        for other in state["prs"].values():
            if other["state"] == "OPEN" and other["baseRefName"] == pr["headRefName"]:
                other["baseRefName"] = TRUNK
        git(state, "update-ref", "-d", f"refs/heads/{pr['headRefName']}")
    if pr.get("onMerge"):
        save(state)
        subprocess.run(["sh", "-c", pr["onMerge"]], cwd=STATE_DIR, check=True,
                       env=dict(os.environ, ORIGIN=state["origin"]))
        state.update(load())


def main():
    args = sys.argv[1:]
    with open(os.path.join(STATE_DIR, "calls"), "a") as f:
        f.write(" ".join(args) + "\n")
    state = load()
    if sync(state):
        save(state)
    pos, opts, fields_kv = [], {}, {}
    i = 2
    while i < len(args):
        if args[i] in ("-F", "-f", "--field", "--raw-field"):
            k, _, v = args[i + 1].partition("=")
            fields_kv[k] = v
            i += 2
        elif args[i].startswith("--"):
            if i + 1 < len(args) and not args[i + 1].startswith("--") and args[i + 1] not in ("-F", "-f") and args[i] not in ("--squash",):
                opts[args[i]] = args[i + 1]
                i += 2
            else:
                opts[args[i]] = True
                i += 1
        else:
            pos.append(args[i])
            i += 1
    group, cmd = args[0], args[1] if len(args) > 1 else ""
    fields, jq = opts.get("--json"), opts.get("--jq")

    if group == "repo" and cmd == "view":
        emit({"squashMergeAllowed": state.get("squashMergeAllowed", True), "defaultBranchRef": {"name": TRUNK},
              "deleteBranchOnMerge": state.get("deleteBranchOnMerge", False)}, fields, jq)
    elif group == "api" and cmd == "graphql":
        query = fields_kv.get("query", "")
        if "stack{number}" in query:
            if state.get("stackQueryError"):
                sys.exit(f"gh: {state['stackQueryError']}")
            emit({"data": {"repository": {"pullRequest": {"stack": state.get("githubStack")}}}}, None, jq)
        else:
            has_q = (state.get("mergeQueue") or state.get("classicMergeQueue")) and fields_kv.get("branch") == TRUNK
            mq = {"id": "MQ_1", "configuration": {"mergeMethod": "SQUASH"}} if has_q else None
            emit({"data": {"repository": {"mergeQueue": mq}}}, None, jq)
    elif group == "api" and cmd == "repos/{owner}/{repo}":
        msg_mode = state.get("squashMergeCommitMessage", "COMMIT_MESSAGES")
        emit({"squash_merge_commit_title": "PR_TITLE" if msg_mode == "BLANK" else "COMMIT_OR_PR_TITLE",
              "squash_merge_commit_message": msg_mode,
              "merge_commit_title": "MERGE_MESSAGE", "merge_commit_message": "PR_TITLE"}, None, jq)
    elif group == "api" and cmd.startswith("repos/{owner}/{repo}/commits/") and cmd.endswith("/check-runs"):
        oid = cmd.split("/")[4]
        emit({"check_runs": check_runs_for(state, oid)}, None, jq)
    elif group == "api" and cmd.startswith("repos/{owner}/{repo}/check-runs/") and cmd.endswith("/annotations"):
        run_id = int(cmd.split("/")[-2])
        pr = state["prs"].get(str(run_id // 100), {})
        by_check = pr.get("annotationsByCheck")
        if by_check is not None:
            index = run_id % 100 - 1
            notes = by_check[index] if index < len(by_check) else []
        else:
            notes = pr.get("annotations", [])
        emit([{"message": m} for m in notes], None, jq)
    elif group == "api":
        rules = [{"type": "merge_queue", "parameters": {"merge_method": "SQUASH"}}] if state.get("mergeQueue") else []
        emit(rules, None, opts.get("--jq"))
    elif group == "pr" and cmd == "view":
        n = pos[0]
        if n not in state["prs"]:
            sys.exit(f"no pull requests found for branch \"{n}\"")
        emit(view(state, n, set(fields.split(",")) if fields else None), fields, jq)
    elif group == "pr" and cmd == "checks":
        checks = view(state, pos[0], {"statusCheckRollup"})["statusCheckRollup"]
        for c in checks:
            print(f"{c['name']}\t{c['conclusion'] or 'pending'}")
        sys.exit(1 if any(c["conclusion"] == "FAILURE" for c in checks) else 0)
    elif group == "pr" and cmd == "edit":
        state["prs"][pos[0]]["baseRefName"] = opts["--base"]
    elif group == "pr" and cmd == "list":
        found = [{"number": int(n)} for n, pr in state["prs"].items()
                 if pr["state"] == "OPEN" and pr["baseRefName"] == opts["--base"]]
        emit(found, None, jq)
    elif group == "pr" and cmd == "merge":
        merge(state, pos[0], opts)
    else:
        sys.exit(f"fake gh: unsupported: {' '.join(args)}")
    if group == "pr" and cmd in ("edit", "merge"):
        sync(state)
        save(state)


main()
