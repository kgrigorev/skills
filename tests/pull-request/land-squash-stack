#!/bin/sh
# Tests skills/pull-request/scripts/land-squash-stack against a bare repo that plays GitHub and a
# stand-in gh (tests/pull-request/fake-gh). Needs git, jq and python3.
# Usage: tests/pull-request/land-squash-stack [scenario...]   (KEEP=1 keeps the temporary repos)
#
# Each scenario builds the stack main <- #1 (b1) <- #2 (b2) <- #3 (b3). #1 and #2 change the same
# line of a.txt, so a plain merge of main into b2 after #1's squash conflicts.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
script=$here/../../skills/pull-request/scripts/land-squash-stack
root=$(mktemp -d "${TMPDIR:-/tmp}/test-land-squash-stack.XXXXXX")
pids=''
kill_tree() {
  kill -STOP "$1" 2>/dev/null || true
  for child in $(pgrep -P "$1" 2>/dev/null || true); do kill_tree "$child"; done
  kill -TERM "$1" 2>/dev/null || true
  kill -CONT "$1" 2>/dev/null || true
}
cleanup() {
  for pid in $pids; do kill_tree "$pid"; done
  for pid in $pids; do wait "$pid" 2>/dev/null || true; done
  [ -n "${KEEP:-}" ] || rm -rf "$root" 2>/dev/null || rm -rf "$root"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
mkdir "$root/bin"
strip_shims() {
  set -f
  IFS=: out=
  for entry in $PATH; do
    case $entry in
      */mise/shims | */mise/shims/) ;;
      *) out=${out:+$out:}$entry ;;
    esac
  done
  printf '%s\n' "$out"
}
no_shims=$(strip_shims)
real_bin() {
  p=$(command -v "$1") || { echo "missing required tool: $1" >&2; exit 1; }
  case $p in
    */mise/shims/*) mise which "$1" 2>/dev/null || PATH=$no_shims command -v "$1" || printf '%s\n' "$p" ;;
    *) printf '%s\n' "$p" ;;
  esac
}
ln -s "$here/fake-gh" "$root/bin/gh"
for tool in git jq python3; do
  bin=$(real_bin "$tool")
  case $bin in /*) ;; *) bin=$PWD/$bin ;; esac
  ln -s "$bin" "$root/bin/$tool"
done
export PATH="$root/bin:$PATH"
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1

commit() { # <dir> <file> <content> <message>
  printf '%s\n' "$3" >"$1/$2"
  git -C "$1" add "$2"
  git -C "$1" commit -q -m "$4"
}

# Builds the baseline stack once in $root/_base; setup copies it per scenario.
build_base() {
  b=$root/_base
  mkdir -p "$b"
  git init -q --bare -b main "$b/origin.git"
  git clone -q "$b/origin.git" "$b/seed" 2>/dev/null
  git -C "$b/seed" checkout -q -b main
  commit "$b/seed" a.txt base 'base'
  commit "$b/seed" c.txt c0 'c'
  git -C "$b/seed" checkout -q -b b1
  commit "$b/seed" a.txt one 'one'
  git -C "$b/seed" checkout -q -b b2
  commit "$b/seed" a.txt two 'two'
  git -C "$b/seed" checkout -q -b b3
  commit "$b/seed" b.txt three 'three'
  git -C "$b/seed" push -q origin main b1 b2 b3
  top_tree=$(git -C "$b/seed" rev-parse 'b3^{tree}')
  git clone -q "$b/origin.git" "$b/work"
}

# Builds the stack in a fresh $t: $t/origin.git, $t/state, and the clone $t/work.
setup() {
  t=$root/$1
  cp -R "$root/_base" "$t"
  mkdir -p "$t/state"
  git -C "$t/seed" remote set-url origin "$t/origin.git"
  git -C "$t/work" remote set-url origin "$t/origin.git"
  cat >"$t/state/state.json" <<EOF
{"origin": "$t/origin.git", "deleteBranchOnMerge": false, "prs": {
 "1": {"title": "feat: one", "body": "One.", "headRefName": "b1", "baseRefName": "main", "state": "OPEN", "isDraft": false},
 "2": {"title": "feat: two", "body": "Two.", "headRefName": "b2", "baseRefName": "b1", "state": "OPEN", "isDraft": false},
 "3": {"title": "feat: three", "body": "Three.", "headRefName": "b3", "baseRefName": "b2", "state": "OPEN", "isDraft": false}}}
EOF
}

state() { # <jq filter>: changes the fake GitHub's state
  jq "$1" "$t/state/state.json" >"$t/state/next.json"
  mv "$t/state/next.json" "$t/state/state.json"
}

# Runs the script in <dir> (default $t/work); sets $status and leaves its output in $t/out.
land() {
  dir=$t/work
  if [ "$1" = -C ]; then dir=$2; shift 2; fi
  status=0
  (cd "$dir" && FAKE_GH_STATE=$t/state LAND_SQUASH_STACK_POLL=0 \
    sh "$script" "$@") >"$t/out" 2>&1 || status=$?
}

fail() {
  echo "FAIL $scenario: $*" >&2
  [ -n "$this_failed" ] || sed 's/^/  | /' "$t/out" >&2
  this_failed=1
}
expect_status() { [ "$status" = "$1" ] || fail "exit status $status, want $1"; }
expect_output() { grep -qF -- "$1" "$t/out" || fail "output lacks: $1"; }
pr_state() { jq -r ".prs[\"$1\"].state" "$t/state/state.json"; }
expect_states() { # <state of #1> <#2> <#3>
  got="$(pr_state 1) $(pr_state 2) $(pr_state 3)"
  [ "$got" = "$*" ] || fail "PR states $got, want $*"
}
expect_untouched() {
  expect_states OPEN OPEN OPEN
  ! grep -q '^pr merge\|^pr edit' "$t/state/calls" 2>/dev/null || fail 'it changed a PR'
  [ "$(git -C "$t/origin.git" rev-list --count main)" = 2 ] || fail 'main moved'
}
expect_main_tree() { # <tree>
  [ "$(git -C "$t/origin.git" rev-parse 'main^{tree}')" = "$1" ] || fail "main's tree is not the top layer's"
}
branch_exists() { git -C "$t/origin.git" rev-parse -q --verify "refs/heads/$1" >/dev/null; }

scenario_lands_the_stack() {
  land 1 2 3
  expect_status 0
  expect_states MERGED MERGED MERGED
  expect_main_tree "$top_tree"
  [ "$(git -C "$t/origin.git" log --format=%s main | head -3 | tr '\n' '|')" = 'feat: three (#3)|feat: two (#2)|feat: one (#1)|' ] ||
    fail 'squash subjects on main are wrong'
  [ "$(git -C "$t/origin.git" log -3 --format=%b main | grep . | tr '\n' '|')" = 'Three.|Two.|One.|' ] ||
    fail 'squash bodies on main are wrong'
  for b in b1 b2 b3; do ! branch_exists "$b" || fail "branch $b was not deleted"; done
}

scenario_lands_with_delete_on_merge() {
  state '.deleteBranchOnMerge = true'
  land 1 2 3
  expect_status 0
  expect_states MERGED MERGED MERGED
  expect_main_tree "$top_tree"
}

scenario_lands_with_blank_squash_message() {
  state '.squashMergeCommitMessage = "BLANK"'
  land 1 2 3
  expect_status 0
  expect_states MERGED MERGED MERGED
  expect_main_tree "$top_tree"
  [ "$(git -C "$t/origin.git" log --format=%s main | head -3 | tr '\n' '|')" = 'feat: three (#3)|feat: two (#2)|feat: one (#1)|' ] ||
    fail 'squash subjects on main are wrong'
  [ -z "$(git -C "$t/origin.git" log -3 --format=%b main | tr -d '\n')" ] ||
    fail 'squash commits kept bodies despite BLANK setting'
}

scenario_dry_run_anywhere_changes_nothing() {
  land 1 2 3 --dry-run
  expect_status 0
  expect_output 'then squash #3'
  expect_untouched
}

scenario_bad_arguments_are_refused() {
  for args in '1 2 --after' '--dryrun 1 2' '1 x 2' '--after 1x 2'; do
    # shellcheck disable=SC2086 # split the argument list on purpose
    land $args
    expect_status 2
  done
  [ ! -e "$t/state/calls" ] || fail 'it called gh on bad arguments'
}

scenario_skipped_layer_is_refused() {
  land 1 3
  expect_status 1
  expect_output '#3 targets b2'
  expect_untouched
}

scenario_unmerged_fix_is_refused_before_landing() {
  git -C "$t/seed" checkout -q b1
  commit "$t/seed" d.txt fix 'fix in b1'
  git -C "$t/seed" push -q origin b1
  land 1 2 3
  expect_status 1
  expect_output "#2 (b2) does not hold #1's head"
  expect_untouched
}

scenario_main_moved_after_a_squash() {
  # Another commit lands on main right after #1's squash.
  # shellcheck disable=SC2016 # expanded by the fake gh
  state '.prs["1"].onMerge = "git clone -q \"$ORIGIN\" m && cd m && echo c1 >c.txt && git commit -qam other && git push -q origin main"'
  land 1 2 3
  expect_status 1
  expect_states MERGED OPEN OPEN
  expect_output "To continue: sh $script 2 3"
  # The advice: a normal merge of main into b2, which must not conflict.
  git -C "$t/work" fetch -q origin
  git -C "$t/work" checkout -q -b b2 origin/b2
  git -C "$t/work" merge -q --no-edit origin/main >/dev/null 2>&1 || fail 'merging main into b2 conflicts'
  git -C "$t/work" checkout -q -b b3 origin/b3
  git -C "$t/work" merge -q --no-edit b2 >/dev/null 2>&1 || fail 'merging b2 into b3 conflicts'
  git -C "$t/work" push -q origin b2 b3
  land 2 3
  expect_status 0
  expect_states MERGED MERGED MERGED
  [ "$(git -C "$t/origin.git" show main:c.txt)" = c1 ] || fail "main lost the other commit"
  [ "$(git -C "$t/origin.git" show main:a.txt)" = two ] || fail "main lost #2's change"
}

scenario_resumes_from_a_fresh_clone() {
  state '.deleteBranchOnMerge = true | .prs["3"].checks = ["FAILURE"]'
  land 1 2 3
  expect_status 1
  expect_states MERGED MERGED OPEN
  expect_output '#3 has failing checks'
  expect_output "To continue: sh $script --after 2 3"
  state '.prs["3"].checks = ["SUCCESS"]'
  git clone -q --no-local "$t/origin.git" "$t/fresh" # only what the branches reach
  land -C "$t/fresh" --after 2 3
  expect_status 0
  expect_states MERGED MERGED MERGED
  expect_main_tree "$top_tree"
}

scenario_draft_stops_at_once() {
  state '.prs["2"].isDraft = true'
  land 1 2 3
  expect_status 1
  expect_output 'gh pr ready 2'
  expect_untouched
}

scenario_blocked_stops_soon() {
  state '.prs["1"].blocked = true'
  land 1 2 3
  expect_status 1
  expect_output '#1 is BLOCKED'
  expect_states OPEN OPEN OPEN
}

scenario_merge_queue_is_refused() {
  state '.classicMergeQueue = true'
  land 1 2 3
  expect_status 1
  expect_output 'Follow GITHUB.md for a merge queue.'
  expect_untouched
}

scenario_squash_disallowed_is_refused() {
  state '.squashMergeAllowed = false'
  land 1 2 3
  expect_status 1
  expect_output 'Follow GITHUB.md for merge commits instead.'
  expect_untouched
}

scenario_closed_pr_is_refused() {
  state '.prs["1"].state = "CLOSED"'
  land 1 2 3
  expect_status 1
  expect_output '#1 is CLOSED'
  ! grep -q '^pr merge\|^pr edit' "$t/state/calls" || fail 'it changed a PR'
}

scenario_keeps_a_branch_other_prs_use() {
  git -C "$t/seed" checkout -q -b b4 b1
  commit "$t/seed" e.txt four 'four'
  git -C "$t/seed" push -q origin b4
  state '.prs["4"] = {"title": "feat: four", "body": "Four.", "headRefName": "b4", "baseRefName": "b1", "state": "OPEN", "isDraft": false}'
  land 1 2 3
  expect_status 0
  branch_exists b1 || fail 'b1 was deleted under #4'
  [ "$(pr_state 4)" = OPEN ] || fail '#4 was closed'
}

all=$(sed -n 's/^scenario_\([a-z_]*\)().*/\1/p' "$0")
failed=''
# shellcheck disable=SC2086 # scenario names, split on purpose
[ "$#" -gt 0 ] || set -- $all
build_base
i=0
for scenario in "$@"; do
  i=$((i + 1))
  (
    this_failed=''
    setup "$i-$scenario"
    "scenario_$scenario"
    [ -z "$this_failed" ]
  ) >"$root/$i.log" 2>&1 &
  pids="$pids $!"
done
i=0
for pid in $pids; do
  i=$((i + 1))
  scenario=$1
  shift
  rc=0
  wait "$pid" || rc=$?
  pids=${pids# "$pid"}
  cat "$root/$i.log" >&2
  if [ "$rc" = 0 ]; then
    echo "ok   $scenario"
  else
    grep -q '^FAIL ' "$root/$i.log" || echo "FAIL $scenario: exited with status $rc" >&2
    failed=1
  fi
done
[ -z "$failed" ] || { echo 'Some scenarios failed.' >&2; exit 1; }
echo 'All scenarios passed.'
