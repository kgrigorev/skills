# Every check run of every PR concludes FAILURE with the billing annotation, and the checks are
# required, so GitHub reports each PR BLOCKED: only gh pr merge --admin merges it.
unstarted_note='The job was not started because recent account payments have failed or your spending limit needs to be increased'
checks_never_start() {
  state "(.prs[] | .checks) = [\"FAILURE\", \"FAILURE\"] | (.prs[] | .annotations) = [\"$unstarted_note\"] | (.prs[] | .blocked) = true"
}
merge_calls() { grep '^pr merge' "$t/state/calls" || true; }

scenario_admin_flag_lands_a_stack_whose_checks_never_start() {
  checks_never_start
  land --admin-if-unstarted 1 2 3
  expect_status 0
  expect_states MERGED MERGED MERGED
  expect_main_tree "$top_tree"
  for n in 1 2 3; do
    expect_output "#$n's checks never started: $unstarted_note. Merging #$n with --admin."
    merge_calls | grep -q "^pr merge $n --squash --admin --match-head-commit " || fail "#$n was not squashed with --admin"
  done
  [ "$(git -C "$t/origin.git" log -3 --format=%b main | grep . | tr '\n' '|')" = 'Three.|Two.|One.|' ] ||
    fail 'squash bodies on main are not the PR bodies'
}

scenario_admin_flag_lands_with_blank_squash_message() {
  checks_never_start
  state '.squashMergeCommitMessage = "BLANK"'
  land --admin-if-unstarted 1 2 3
  expect_status 0
  expect_states MERGED MERGED MERGED
  expect_main_tree "$top_tree"
  for n in 1 2 3; do
    merge_calls | grep -q "^pr merge $n --squash --admin --match-head-commit [0-9a-f]*\$" ||
      fail "#$n was not squashed with --admin and GitHub's message"
  done
}

# Three reads report UNKNOWN, so a merge sent on the second read, when the checks agree for the
# first time, still finds mergeable UNKNOWN and fails.
