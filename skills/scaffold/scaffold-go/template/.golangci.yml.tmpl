# golangci-lint rules for {{package}}. Every finding fails scripts/check.
# Agents: change this file only with the owner's approval.
# scripts/check rejects //nolint and other inline switches: fix the cause instead.
version: "2"

run:
  # go.mod and go.sum must already be complete; the linter never edits them.
  modules-download-mode: readonly

formatters:
  enable:
    - gofumpt # gofmt plus stricter rules, so formatting has one answer
    - gci # one fixed import order: standard library, other modules, this module
  settings:
    gci:
      sections: [standard, default, localmodule]
  exclusions:
    # A "Code generated ... DO NOT EDIT." header must not switch formatting off.
    generated: disable

linters:
  # standard = errcheck, govet, ineffassign, staticcheck, unused.
  default: standard
  enable:
    # Bugs
    - bidichk # hidden Unicode that makes code read differently from how it runs
    - bodyclose # HTTP response bodies left open
    - depguard # imports that need the owner's approval: see settings
    - durationcheck # two durations multiplied together
    - errorlint # error comparisons that break on wrapped errors
    - exhaustive # a switch on an enum that misses a value
    - gocheckcompilerdirectives # misspelled //go: directives, which Go ignores silently
    - gomoddirectives # go.mod directives that bend the build: see settings
    - gosec # common security mistakes
    - makezero # append to a slice made with a non-zero length
    - nilerr # returns nil after checking that err is not nil
    - nilnesserr # returns a different, nil error after an err check
    - nilnil # returns nil, nil: callers cannot tell "not found" from success
    - noctx # network calls without a context, which cannot be cancelled
    - predeclared # names that hide built-ins such as len, new or max
    - reassign # reassigns another package's variables, such as io.EOF
    - recvcheck # mixes value and pointer receivers on one type
    - unparam # parameters every caller passes the same value for
    - wastedassign # values assigned and never read
    # Errors say what failed
    - wrapcheck # errors from other packages returned without context
    # Modern, plain Go
    - gocritic # bug patterns and simpler equivalents
    - modernize # older idioms that newer Go replaces, e.g. min, max, slices.Contains
    - unconvert # needless type conversions
    - usestdlibvars # literals where the standard library has a name, e.g. http.MethodGet
    - misspell # common English misspellings in comments and strings
    # Readable for the reader named in AGENTS.md
    - godoclint # every declaration has a doc comment that starts with its name
    - gocognit # functions too tangled to follow
    - nestif # deeply nested if statements
    - funlen # functions too long to read on one screen
    - gochecknoglobals # mutable package-level state
    - gochecknoinits # init functions, which run hidden at import
    - forbidigo # printing, logging, exiting or panicking in the library
    # Tests
    - thelper # helpers without t.Helper(), so failures point at the wrong line
    - tparallel # t.Parallel used in a way that does not run in parallel
    - usetesting # os.MkdirTemp, os.Setenv, context.Background in tests: testing has safer versions
  settings:
    errcheck:
      check-type-assertions: true # x := y.(T) panics; use the two-value form
      check-blank: true # _ = f() hides an error; handle it
    govet:
      enable-all: true
      disable:
        - fieldalignment # struct memory layout; noise for readable code
        - shadow # flags correct code (a new err inside an if); Go leaves it out of go vet too
    staticcheck:
      checks: [all] # includes the checks on names and doc comment form
    exhaustive:
      default-signifies-exhaustive: false # a default case does not excuse a missing value
    godoclint:
      default: basic
      enable: [require-doc, require-pkg-doc, start-with-name]
      options:
        require-doc:
          ignore-unexported: false # unexported helpers are read too
        start-with-name:
          include-unexported: true
    gomoddirectives:
      replace-local: false # a replace to a local folder builds on one machine only
      exclude-forbidden: true # `exclude` skips a dependency version without a trace in the code
      ignore-forbidden: true # `ignore` hides folders from ./..., so from every gate
      toolchain-forbidden: true # mise.toml pins the Go toolchain
      tool-forbidden: true # tools are pinned in mise.toml, not in go.mod
      go-debug-forbidden: true # godebug switches runtime behaviour off the defaults
    gocognit:
      min-complexity: 15
    nestif:
      min-complexity: 4
    funlen:
      lines: 60
      statements: 40
      ignore-comments: true
    forbidigo:
      forbid:
        # Each pattern names a way to write to the terminal, a global logger or the exit code.
        - pattern: ^(fmt\.Print.*|print|println|os\.(Stdout|Stderr))$
          msg: Return values from the library; print only in cmd/.
        - pattern: ^(log\.(Print|Fatal|Panic|Default|SetOutput|Output|Writer).*|slog\.(Debug|Info|Warn|Error|Log|LogAttrs|Default|SetDefault).*)$
          msg: Take a logger as a parameter, or return the information; log only in cmd/.
        - pattern: ^(os\.Exit|syscall\.Exit|runtime\.Goexit)$
          msg: Return an error; only main decides the exit code.
        - pattern: ^panic$
          msg: Return an error instead.
    depguard:
      rules:
        # CODING_STANDARDS.md: reflection, unsafe and C code need the owner's approval. When the
        # owner approves one, remove its entry here and add it to the approved extras there.
        escape-hatches:
          deny:
            # A cgo file (import "C") imports unsafe too, so this also catches C code, which
            # no check here reads. depguard does not match "C" itself.
            - pkg: unsafe
              desc: bypasses the type system (cgo uses it too); needs the owner's approval
        reflection:
          # Tests may compare values with reflect.DeepEqual.
          files: ["!$test"]
          deny:
            - pkg: reflect
              desc: bypasses static types; needs the owner's approval
  exclusions:
    # A "Code generated ... DO NOT EDIT." header must not switch the linters off. A real
    # generated file needs the owner's approval and an exclusion rule below.
    generated: disable
    rules:
      # The command is where printing and exiting belong.
      - path: ^cmd/
        linters: [forbidigo]
      # Table tests are long by nature.
      - path: _test\.go$
        linters: [funlen]

issues:
  # Show every finding, so one run lists all the work.
  max-issues-per-linter: 0
  max-same-issues: 0
