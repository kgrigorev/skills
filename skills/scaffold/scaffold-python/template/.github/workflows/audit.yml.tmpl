name: audit

# Online and random checks. Their results change from day to day, so they never block a merge
# and are not in scripts/check.
on:
  schedule:
    - cron: "0 6 * * 1"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  audit:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v7

      # The same setup as in ci.yml. Change both together.
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: true
          cache-python: true

      - run: uv sync --locked

      # uv audit is a preview feature, so it runs here and not in scripts/check.
      - name: Known vulnerabilities in the locked packages
        run: uv audit --locked --preview-features audit-command

      - name: Outdated direct dependencies (report only)
        run: uv tree --outdated --depth 1

      # A failure prints a @reproduce_failure line. Turn the failing input into an @example test.
      - name: Property tests with new random examples
        run: uv run --no-sync pytest --hypothesis-profile=explore
