"""Shared test settings and gates. Agents: change only with the owner's approval."""

import inspect
import os
import sys
import warnings
from collections.abc import Generator
from types import CodeType

import pytest
from hypothesis import HealthCheck, settings

# scripts/check runs the "check" profile: the same examples on every run and machine.
# database=None: a failure saved on one machine cannot change the result on another.
# deadline=None, too_slow: a slow machine must not turn a passing test into a failure.
settings.register_profile(
    "check",
    derandomize=True,
    database=None,
    deadline=None,
    suppress_health_check=[HealthCheck.too_slow],
)

# The weekly audit workflow runs "explore": new random examples, many more of them.
settings.register_profile("explore", max_examples=2000, database=None, deadline=None)

# The profile objects as registered here. A test with settings of its own (also through
# another import path or a decorator such as @seed), or a test module that registers a
# profile again, gets a different object.
_PROFILES = [settings.get_profile(name) for name in ("default", "check", "explore")]

# The checks below keep their own record of what ran. pytest's own counts and reports
# are plain attributes that a test can change (session.testsfailed = 0).
_failed: list[str] = []
_reported: set[str] = set()
_collected: list[str] = []
_plugins: set[object] = set()


def pytest_configure(config: pytest.Config) -> None:
    """Refuse to run with settings from any file but pyproject.toml.

    A pytest.toml, pytest.ini or tox.ini would replace strict mode, the warning
    filter and the import mode there without a word.
    """
    if config.inipath != config.rootpath / "pyproject.toml":
        msg = f"pytest read its settings from {config.inipath}. Remove that file."
        raise pytest.UsageError(msg)


@pytest.hookimpl(trylast=True)
def pytest_sessionstart(session: pytest.Session) -> None:
    """Remember the plugins before any test module is imported."""
    _plugins.update(session.config.pluginmanager.get_plugins())


def pytest_collectstart(collector: pytest.Collector) -> None:
    """Remember every test module pytest starts to collect."""
    if isinstance(collector, pytest.Module):
        _modules.append(collector)


def _fail_on_new_plugins(config: pytest.Config) -> None:
    """Stop the run at once when code registered a pytest plugin after startup.

    A plugin added by a test can rewrite any report and the exit status, so no
    later check could be trusted. os._exit ends the process before it can. pytest
    adds plugins of its own on the way, for example for --lf.
    """
    manager = config.pluginmanager
    added = {
        plugin
        for plugin in manager.get_plugins() - _plugins
        if not getattr(type(plugin), "__module__", "").startswith("_pytest.")
    }
    if added:
        names = ", ".join(sorted(str(manager.get_name(plugin)) for plugin in added))
        sys.stderr.write(f"\nA test registered pytest plugins: {names}. Remove them.\n")
        sys.stderr.flush()
        os._exit(pytest.ExitCode.USAGE_ERROR)


@pytest.hookimpl(wrapper=True)
def pytest_collection_modifyitems(
    config: pytest.Config, items: list[pytest.Item]
) -> Generator[None]:
    """Fail when a plugin or conftest drops tests that the caller did not deselect.

    -k, -m, --deselect, --lf and --sw still work by hand. scripts/check passes
    none of them.
    """
    _fail_on_new_plugins(config)
    collected = len(items)
    asked = any(
        config.getoption(name, None)
        for name in ("keyword", "markexpr", "deselect", "lf", "stepwise")
    )
    if not config.getoption("lf", None):
        _fail_on_uncollected_tests(items)
    _fail_on_own_hypothesis_settings(items)
    yield
    dropped = collected - len(items)
    if dropped and not asked:
        msg = f"Collected tests were dropped: {dropped}. Run or delete them."
        raise pytest.UsageError(msg)
    _collected.extend(item.nodeid for item in items)


# Tests that did not run: skipped (by a mark, pytest.skip or unittest.SkipTest) or
# expected to fail (xfail). A test that does not run checks nothing.
_not_run: list[str] = []


def pytest_runtest_logreport(report: pytest.TestReport) -> None:
    """Remember every test that was skipped or marked as expected to fail."""
    if report.skipped:
        _not_run.append(report.nodeid)


@pytest.hookimpl(wrapper=True, trylast=True)
def pytest_runtest_makereport(
    item: pytest.Item,
) -> Generator[None, pytest.TestReport, pytest.TestReport]:
    """Record each result as pytest first made it.

    trylast: this wrapper sits inside every other one, so a plugin that rewrites
    the outcome later cannot change what is recorded here.
    """
    report = yield
    _fail_on_new_plugins(item.config)
    if report.failed:
        _failed.append(report.nodeid)
    if report.when == "call" or not report.passed:
        _reported.add(report.nodeid)
    return report


# The AssertionErrors that code caught while the current test body ran.
_caught_assert: list[str] = []


def _on_exception_handled(
    code: CodeType, offset: int, exception: BaseException
) -> None:
    """Note an AssertionError that some code caught, while a test body runs."""
    del code, offset
    if isinstance(exception, AssertionError):
        _caught_assert.append(type(exception).__name__)


def _monitoring_tool() -> int:
    """Return a free sys.monitoring tool id. Coverage and debuggers use others."""
    for tool in (3, 4):
        if sys.monitoring.get_tool(tool) is None:
            sys.monitoring.use_tool_id(tool, "tests/conftest.py")
            sys.monitoring.register_callback(
                tool, sys.monitoring.events.EXCEPTION_HANDLED, _on_exception_handled
            )
            return tool
    msg = "No free sys.monitoring tool id for the caught-assert check."
    raise pytest.UsageError(msg)


_TOOL = _monitoring_tool()


# The warning filters as they were before a test's fixtures ran.
_FILTERS = pytest.StashKey[tuple[object, ...]]()


@pytest.hookimpl(wrapper=True, tryfirst=True)
def pytest_runtest_setup(item: pytest.Item) -> Generator[None]:
    """Remember the warning filters before fixtures run."""
    item.stash[_FILTERS] = tuple(warnings.filters)
    return (yield)


@pytest.hookimpl(wrapper=True)
def pytest_runtest_call(item: pytest.Item) -> Generator[None]:
    """Fail a passing test that caught a failing assert or changed the warning filters.

    A failing assert raises AssertionError. Code that catches it, under any name or
    with any context manager, makes the test pass because of the bug. A fixture such
    as recwarn, or a call such as warnings.resetwarnings(), turns warnings back into
    messages, and a warning is a failure here.
    """
    _caught_assert.clear()
    sys.monitoring.set_events(_TOOL, sys.monitoring.events.EXCEPTION_HANDLED)
    try:
        result = yield
    finally:
        sys.monitoring.set_events(_TOOL, sys.monitoring.events.NO_EVENTS)
    if _caught_assert:
        pytest.fail(
            "The test caught a failing assert (AssertionError), so it passed anyway. "
            "Let the assert fail; pytest.raises tests an expected exception.",
            pytrace=False,
        )
    if tuple(warnings.filters) != item.stash[_FILTERS] or any(
        item.iter_markers("filterwarnings")
    ):
        pytest.fail(
            "The test or a fixture changed the warning filters (recwarn, "
            "resetwarnings, warnings.filters), so warnings did not fail it. "
            "pytest.warns tests an expected warning.",
            pytrace=False,
        )
    return result


@pytest.hookimpl(trylast=True)
def pytest_sessionfinish(session: pytest.Session) -> None:
    """Fail the run when a test failed, did not run, or was skipped."""
    if session.exitstatus != pytest.ExitCode.OK or session.config.option.collectonly:
        return
    never_ran = [nodeid for nodeid in _collected if nodeid not in _reported]
    problems = [
        ("Tests that failed:", _failed),
        ("Tests that never ran:", never_ran),
        ("Tests that did not run (make them run or delete them):", _not_run),
    ]
    writer = session.config.get_terminal_writer()
    for title, nodeids in problems:
        if nodeids:
            session.exitstatus = pytest.ExitCode.TESTS_FAILED
            writer.line(title, red=True)
            for nodeid in nodeids:
                writer.line(f"  {nodeid}")


# The test modules that pytest imported without an error.
_modules: list[pytest.Module] = []
_imported: set[str] = set()


def pytest_collectreport(report: pytest.CollectReport) -> None:
    """Remember every collector that pytest collected without an error."""
    if report.passed:
        _imported.add(report.nodeid)


def _class_tests(
    name: str, cls: type, module: pytest.Module
) -> Generator[tuple[str | None, str]]:
    """Yield (class path, method name) of each test in a class and its inner classes."""
    for attribute, value in vars(cls).items():
        function = value.__func__ if isinstance(value, staticmethod) else value
        if inspect.isfunction(function) and module.funcnamefilter(attribute):
            yield name, attribute
        elif inspect.isclass(value) and module.classnamefilter(attribute):
            yield from _class_tests(f"{name}.{attribute}", value, module)


def _defined_tests(module: pytest.Module) -> set[tuple[str | None, str]]:
    """Return (class path or None, function name) of every test the module defines.

    pytest's own name rules decide what a test is. Names imported from elsewhere are
    left out: their own module collects them.
    """
    found: set[tuple[str | None, str]] = set()
    name = module.obj.__name__
    for attribute, value in vars(module.obj).items():
        if getattr(value, "__module__", None) != name:
            continue
        if inspect.isfunction(value) and module.funcnamefilter(attribute):
            found.add((None, attribute))
        elif inspect.isclass(value) and module.classnamefilter(attribute):
            found.update(_class_tests(attribute, value, module))
    return found


def _fail_on_uncollected_tests(items: list[pytest.Item]) -> None:
    """Fail when a test module defines a test that pytest did not collect.

    A `__test__ = False`, also set at run time through globals() or setattr, hides
    a test from pytest without any skip or deselect.
    """
    collected = {
        (item.path, item.cls.__qualname__ if item.cls else None, item.originalname)
        for item in items
        if isinstance(item, pytest.Function)
    }
    missing = [
        f"{module.nodeid}::{f'{cls.replace(".", "::")}::' if cls else ''}{function}"
        for module in _modules
        if module.nodeid in _imported
        for cls, function in sorted(_defined_tests(module), key=str)
        if (module.path, cls, function) not in collected
    ]
    if missing:
        msg = (
            f"pytest did not collect these tests: {', '.join(missing)}. Make them run."
        )
        raise pytest.UsageError(msg)


def _fail_on_own_hypothesis_settings(items: list[pytest.Item]) -> None:
    """Fail when a Hypothesis test runs with settings that are not the active profile.

    ruff's banned-api and the search in scripts/check see @settings only under the
    names they know. This looks at the settings each test really runs with. The
    attributes are Hypothesis internals: if a new version renames the settings one,
    every @given test fails here, so the bump cannot switch this part off quietly.
    """
    active = settings.default
    machines = [
        item.nodeid
        for item in items
        if isinstance(item, pytest.Function)
        and getattr(item.obj, "_hypothesis_state_machine_class", None) is not None
    ]
    if machines:
        msg = (
            f"Run state machines from a plain test with "
            f"run_state_machine_as_test(Machine), not as Machine.TestCase: "
            f"{', '.join(machines)}."
        )
        raise pytest.UsageError(msg)
    own = [
        item.nodeid
        for item in items
        if isinstance(item, pytest.Function)
        and getattr(item.obj, "is_hypothesis_test", False)
        and (
            all(active is not profile for profile in _PROFILES)
            or getattr(item.obj, "_hypothesis_internal_use_settings", None)
            is not active
            or getattr(item.obj, "_hypothesis_internal_use_seed", None) is not None
            or getattr(item.obj, "_hypothesis_internal_use_reproduce_failure", None)
            is not None
        )
    ]
    if own:
        msg = (
            f"These Hypothesis tests do not run the profile from tests/conftest.py: "
            f"{', '.join(own)}. Remove their own settings."
        )
        raise pytest.UsageError(msg)
