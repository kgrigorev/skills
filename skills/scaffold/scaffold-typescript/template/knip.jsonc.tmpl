{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // Unused files, exports and dependencies. knip finds the entry points itself: src/main.ts from
  // the "start" script in package.json, the tests and vitest.config.ts from its vitest plugin.
  // A new program or script needs a package.json script or an "entry" here.
  // Agents: change this file only with the owner's approval.
  "project": ["**/*.ts"],
}
