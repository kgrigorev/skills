# Exact Node and pnpm for this project. mise.lock holds their download URLs and checksums.
# package.json devEngines repeats both versions, and pnpm refuses to run with any other,
# so change both files together. Agents: change this file only with the owner's approval.
[tools]
node = "26.13.1"
pnpm = "12.21.0"

[settings]
lockfile = true
