name: ci

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      # Install only what mise.lock lists, by URL and checksum.
      MISE_LOCKED: "1"
      MISE_TRUSTED_CONFIG_PATHS: ${{ github.workspace }}
    steps:
      - uses: actions/checkout@v7
      # Installs mise and every tool in mise.toml at the versions in mise.lock, and caches them
      # (about 1 GB unpacked for LLVM), keyed on both files.
      - uses: jdx/mise-action@v5
        with:
          version: 2026.11.8
      # No cache for build/: a clean build takes seconds, and an old CMake cache can hide a change.
      - run: scripts/check
