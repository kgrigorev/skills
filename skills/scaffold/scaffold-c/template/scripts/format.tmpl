#!/bin/sh
# Formats every C file with the pinned clang-format and the rules in .clang-format. The file list
# is the one scripts/check reads.
set -eu
cd "$(dirname "$0")/.."
# Tracked files deleted from disk are left out.
files=$(git ls-files -co --exclude-per-directory=.gitignore -- '*.c' '*.h' '*.inc' \
  ':!:third_party/unity/*' | while IFS= read -r file; do
  if [ -e "$file" ]; then printf '%s\n' "$file"; fi
done)
# shellcheck disable=SC2086 # file names have no spaces
exec mise exec -- clang-format -i $files
