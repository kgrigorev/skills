#!/bin/sh
# Runs every quality gate. People, agents, the git hook and CI all run this script.
# It stops at the first failure. Agents: change it only with the owner's approval.
set -eu
cd "$(dirname "$0")/.."

# mise.toml pins every tool. Run under `mise exec`, so the pinned versions win even in a shell
# where mise is not activated, such as an agent's Bash tool or a git hook. The absolute path
# makes the script work from any folder.
if [ "${SCRIPTS_CHECK_UNDER_MISE:-}" != 1 ]; then
  command -v mise >/dev/null 2>&1 || {
    echo 'mise is not on PATH. Install it: https://mise.jdx.dev/getting-started.html' >&2
    exit 1
  }
  SCRIPTS_CHECK_UNDER_MISE=1 exec mise exec -- "$(pwd -P)/scripts/check" "$@"
fi

step() { printf '\n==> %s\n' "$1"; }
fail() {
  printf '%s\n' "$1" >&2
  exit 1
}
# The tools see only these variables. A variable from the caller's shell or from a mise config,
# such as CFLAGS, LSAN_OPTIONS or CMAKE_C_COMPILER_LAUNCHER, cannot change a result.
run() { env -i PATH="$PATH" HOME="$HOME" TMPDIR="${TMPDIR:-/tmp}" "$@"; }

root=$(pwd -P)
# The test framework, vendored unchanged. It is the only C code built without the gates.
unity=third_party/unity
# Files git would commit: tracked or new, minus what the repository's .gitignore files list. A
# personal global ignore file does not change the result.
files() { git ls-files -co --exclude-per-directory=.gitignore -- "$@"; }
# Every C file of the project. The build checks below fail when a compiled or included project
# file is not in this list, so the format and the searches cannot miss one.
c_files=$(files '*.c' '*.h' '*.inc' ":!:$unity/*")
# Build files that agents edit. cmake/gates.cmake holds the gates and is the owner's.
cmake_files=$(files 'CMakeLists.txt' '*/CMakeLists.txt' '*.cmake' ":!:$unity/*" ':!:cmake/gates.cmake')

step 'Tool versions (pinned in mise.toml and mise.lock)'
pinned() { sed -n "s/^\"*$1\"* = \"\(.*\)\"$/\1/p" mise.toml; }
for pair in conda:clang=clang conda:clang-tools=clang-tidy conda:clang-format=clang-format \
  cmake=cmake ninja=ninja; do
  tool=${pair%=*}
  bin=${pair##*=}
  dir=$(mise where "$tool@$(pinned "$tool")") || fail "mise has not installed $tool. Run: mise install"
  path=$(command -v "$bin") || fail "$bin is not on PATH."
  case $path in
  "$dir"/*) printf '%s %s\n' "$bin" "$(pinned "$tool")" ;;
  *) fail "$bin runs from $path, not from the version that mise.toml pins ($dir)." ;;
  esac
done
clang_dir=$(mise where "conda:clang@$(pinned conda:clang)")
# A version in mise.toml that mise.lock does not hold runs here, but CI cannot install it.
drift=$(mise lock --dry-run --json 2>/dev/null) || drift='mise lock failed'
[ "$drift" = '[]' ] || fail "$drift
mise.toml and mise.lock name different versions. Run \`mise lock\` and commit both files."
# Another mise config in the repository, such as mise.local.toml, could change a tool.
configs=$(mise config ls --json | sed -n 's/^ *"path": "\(.*\)",*$/\1/p' |
  grep -F "$root/" | grep -vxF "$root/mise.toml" || true)
[ -z "$configs" ] || fail "$configs
Only mise.toml configures mise in this repository. Remove the files above."

step 'Format (clang-format, rules in .clang-format). Fix: scripts/format'
# shellcheck disable=SC2086 # file names have no spaces
run clang-format --dry-run --Werror $c_files

step 'No switched-off checks'
# In C source: comments, pragmas, attributes and macros that switch off a warning, clang-tidy, the
# analyzer, clang-format, a sanitizer or a test. Every #pragma except `#pragma once` counts.
# `#line` and line markers would make the compiler read the code as another file.
# __has_feature and __has_extension can ask whether a sanitizer is on; a plain word such as
# name_sanitizer is fine.
c_off='NOLINT|_Pragma|#[[:space:]]*pragma|^[[:space:]]*#[[:space:]]*(line|[0-9])|clang-format[[:space:]]+off|__clang_analyzer__|__has_(feature|extension)|__SANITIZE_|no_sanitize|no_address_safety_analysis|disable_sanitizer_instrumentation|maybe_unused|__attribute__.*unused|gnu::(__)?unused|clang::suppress|__(asan|lsan|ubsan|sanitizer)_|#[[:space:]]*(define|undef)[[:space:]]+(TEST_|UNITY_|RUN_TEST|setUp|tearDown)|TEST_(IGNORE|PASS)'
# In CMake, in any letter case: anything that changes warnings, clang-tidy or how a test passes.
cmake_off='CLANG_TIDY|SKIP_LINTING|WARNING_AS_ERROR|compile_options|COMPILE_FLAGS|_FLAGS|-Wno-|[[:space:]"(]-w([[:space:]")]|$)|add_test|set_tests_properties|set_property|set_directory_properties|set_source_files_properties|DISABLED|WILL_FAIL|SKIP_RETURN_CODE|REGULAR_EXPRESSION|EXCLUDE_FROM_ALL'
# shellcheck disable=SC2086 # file names have no spaces
found=$(
  {
    grep -nE "$c_off" $c_files /dev/null | grep -vE ':[[:space:]]*#[[:space:]]*pragma[[:space:]]+once[[:space:]]*$' || true
    grep -niE "$cmake_off" $cmake_files /dev/null || true
  }
)
[ -z "$found" ] || fail "$found
The lines above switch off a check. Remove them and fix the cause."
# A lint or format config in a subfolder, in any letter case, replaces the root one there.
nested=$(find . \( -path ./build -o -path ./.git \) -prune -o \( -iname '[._]clang-tidy' -o \
  -iname '[._]clang-format' -o -iname '.clang-format-ignore' \) -print |
  grep -vxE '\./\.clang-(tidy|format)' || true)
[ -z "$nested" ] || fail "$nested
The files above override the root lint or format rules. Remove them."
# Unity is built without the gates, and its summary decides whether a test passed.
# shellcheck disable=SC2046 # file names have no spaces
[ "$(run cmake -E sha256sum $(files "$unity"))" = "44faafa986e325f6d5152cddba20fa7c0a4dc7d4503fc1bbaf6e53e05f6a3746  $unity/CMakeLists.txt
ec6cf55f05ba2aa538b9677b2481b9ac14a87c63594fce8a0677d4f71c583980  $unity/LICENSE.txt
a6cc4b143075a03317d72c760b5ed67a4a12eeda1242f575464ad23f34042275  $unity/unity.c
b30ba4db1e0be1a1f6c862d359d73c91025a114977e41d3dad17103363804334  $unity/unity.h
35bffad23ebc533977291e7a848c646027513572268fbfa9bd03d5ec21ee818a  $unity/unity_internals.h" ] ||
  fail "$unity/ differs from Unity 2.7.0 as vendored. Restore it: git checkout -- $unity"

step 'Build (clang-tidy on every changed file, warnings are errors, sanitizers on)'
# Ninja does not track the tools or .clang-tidy, so a change to them would leave old results in
# place, and CMake refuses a build folder made for another path. Start from a clean build folder
# when any of them changed, or when the project moved.
inputs=$( (printf '%s\n' "$root" && cat mise.lock CMakePresets.json .clang-tidy) | cksum)
if [ "$(cat build/dev/.check-inputs 2>/dev/null || true)" != "$inputs" ]; then
  rm -rf build/dev
fi
run cmake --preset dev --log-level=WARNING
printf '%s\n' "$inputs" >build/dev/.check-inputs
run cmake --build --preset dev

step 'Every project file is built with the gates'
# Read from the build itself, so no CMake spelling can skip a gate: every compile command for a
# project file must run clang-tidy and the pinned clang with the gate flags, and nothing that
# turns them off. A file that only a target outside `all` lists is never built or tested.
gate_flags="-std=c23 -Wall -Wextra -Wpedantic -Wconversion -Wdouble-promotion -Wshadow -Wundef \
-Wvla -Wcast-qual -Wwrite-strings -Wstrict-prototypes -Wmissing-prototypes \
-Wmissing-variable-declarations -Wformat=2 -Wimplicit-fallthrough -Wcomma -Werror \
-fsanitize=address,undefined -fno-sanitize-recover=all"
off_flags='-w|--no-warnings|-Wno-.*|-Wp,.*|-X.*|-mllvm|-include.*|--include.*|-imacros.*|-isystem.+|-idirafter.*|-iwithprefix.*|-iwithsysroot.*|--(no-)?system-header-prefix.*|--config|-fno-sanitize.*|-fsanitize-recover.*|-fsanitize-(ignore|black)list.*|-std=.*|-DNDEBUG.*|-[DU](TEST_|UNITY_|RUN_TEST).*|@.*'
rm -f build/dev/check-objects build/dev/check-preprocess
# shellcheck disable=SC2086 # file names have no spaces
report=$(run ninja -C build/dev -t commands all | awk -v root="$root/" -v unity="$root/$unity" \
  -v clang="$clang_dir/" -v gate_flags="$gate_flags" -v off_flags="^($off_flags)\$" \
  -v files=" $(printf '%s ' $c_files)" '
  / -c / {
    source = $NF
    if (match($0, / -o [^ ]+ -c /)) print substr($0, RSTART + 4, RLENGTH - 8) > "build/dev/check-objects"
    if (index(source, root) != 1 || index(source, unity "/") == 1) next
    file = substr(source, length(root) + 1)
    built[file] = 1
    if (index(files, " " file " ") == 0) print file ": built, but git ignores it."
    if ($0 !~ /__run_co_compile --tidy="clang-tidy(;--extra-arg-before=--driver-mode=gcc)?" --source=[^ ]+ -- /) {
      print file ": built without clang-tidy."
      next
    }
    n = split(substr($0, index($0, " -- ") + 4), arg, " ")
    if (index(arg[1], clang) != 1) print file ": built with " arg[1] ", not the pinned clang."
    split("", seen)
    for (i = 2; i <= n; i++) {
      seen[arg[i]] = 1
      if (arg[i] == "-isystem" && arg[i + 1] == unity) { i++; continue }
      if (arg[i] ~ /^(--config|-resource-dir)=/ && index(arg[i], "=" clang) > 0) continue
      if (arg[i] == "-fno-sanitize-recover=all" || arg[i] == "-std=c23") continue
      if (arg[i] ~ off_flags || arg[i] ~ /^(--config|-resource-dir)/ || arg[i] == "-isystem")
        print file ": built with " arg[i] (arg[i] == "-isystem" ? " " arg[i + 1] : "") "."
    }
    m = split(gate_flags, flag, " ")
    for (i = 1; i <= m; i++) if (!(flag[i] in seen)) print file ": built without " flag[i] "."
    # The same command, preprocessed, for the search below.
    pp = substr($0, index($0, " -- ") + 4)
    sub(/ -MD -MT [^ ]+ -MF [^ ]+/, "", pp)
    sub(/ -o [^ ]+ -c /, " -E ", pp)
    print pp > "build/dev/check-preprocess"
  }
  END {
    n = split(files, listed, " ")
    for (i = 1; i <= n; i++)
      if (listed[i] ~ /\.c$/ && !(listed[i] in built)) print listed[i] ": not built. Add it to a target after include(cmake/gates.cmake)."
  }')
[ -z "$report" ] || fail "$report
Every project file must be built by the default target, after include(cmake/gates.cmake)."
# A file that a project file includes must be one the format and the searches read. Only the
# objects of the current build count: the deps log keeps entries for objects that are gone.
# shellcheck disable=SC2046 # file names have no spaces
deps=$(run ninja -C build/dev -t deps $(cat build/dev/check-objects))
included=$(printf '%s\n' "$deps" | sed -n "s|^    $root/||p" | grep -v "^$unity/" | sort -u)
# shellcheck disable=SC2086 # file names have no spaces
unlisted=$(printf '%s\n' "$included" | grep -vxF "$(printf '%s\n' $c_files)" || true)
[ -z "$unlisted" ] || fail "$unlisted
These files are included but are not .h or .inc files that git tracks. Rename or track them."
# The pinned clang ships libraries (zlib, openssl, iconv, ...) next to it, and its default
# config puts their headers on the include path. Code that uses them builds here and nowhere
# else, so it must declare a real dependency instead.
toolchain_headers=$(printf '%s\n' "$deps" | grep -E '/conda-clang/[^/]+/include/' || true)
[ -z "$toolchain_headers" ] || fail "$toolchain_headers
These headers come from the compiler's own folder, not from a declared dependency."
# A file from outside the repository must come through an include folder: the compiler's own
# list (the C library and the OS), or an -I folder that CMake declares for a dependency, which
# review sees. `#include "../../x.h"` or "/tmp/x.h" would bring in code that no search reads and
# that CI does not have. The SDK's SDKSettings.json is read by the compiler, not included.
{
  run clang -xc -E -v - </dev/null 2>&1 | sed -n '/<\.\.\.> search starts here:/,/^End of search list/p' |
    sed -n 's/^ //p' | sed 's/ (framework directory)$//'
  tr ' ' '\n' <build/dev/check-preprocess | sed -n 's/^-I\(..*\)$/\1/p'
} >build/dev/check-include-dirs
outside=$(printf '%s\n' "$deps" | awk -v root="$root/" -v clang="$clang_dir/" '
  BEGIN { while ((getline line <"build/dev/check-include-dirs") > 0) dir[++n] = line }
  /^    / {
    path = substr($0, 5)
    if (index(path, root) == 1 || index(path, clang) == 1) next
    for (i = 1; i <= n; i++) {
      sdk = dir[i]
      sub(/\/usr\/include$/, "", sdk)
      if (dir[i] == "") continue
      if (index(path, dir[i] "/") == 1 || path == sdk "/SDKSettings.json") next
    }
    print path
  }' | sort -u)
[ -z "$outside" ] || fail "$outside
These files are included from outside the repository, not through an include folder."

step 'No switched-off checks after macro expansion'
# The compiler sees code after macros expand, so a macro could hide a pragma or an attribute from
# the search above. Search the project's lines of the preprocessed code too.
# An unused attribute counts only inside __attribute__((...)) or [[...]]: a variable named
# `unused` passed to a macro, as in `f((unused))` or `f(a, unused)`, is fine.
pp_off='#[[:space:]]*pragma|no_sanitize|no_address_safety_analysis|disable_sanitizer_instrumentation|__attribute(__)?[[:space:]]*\([[:space:]]*\((([^()]|\([^()]*\))*[^[:alnum:]_])?(__)?unused(__)?([^[:alnum:]_]|$)|\[[[:space:]]*\[[^]]*unused|clang::suppress|__(asan|lsan|ubsan|sanitizer)_|__declspec'
found=$(
  while IFS= read -r command; do
    (cd build/dev && run sh -c "$command")
  done <build/dev/check-preprocess | awk -v root="$root/" -v unity="$root/$unity/" '
    /^# [0-9]+ "/ { file = $3; gsub(/"/, "", file); line = $2 - 1; next }
    { line++ }
    index(file, root) == 1 && index(file, unity) != 1 { print substr(file, length(root) + 1) ":" line ": " $0 }' |
    grep -E "^[^:]+:[0-9]+: .*($pp_off)" | grep -vE ': [[:space:]]*#[[:space:]]*pragma[[:space:]]+once[[:space:]]*$' | sort -u || true
)
[ -z "$found" ] || fail "$found
After macro expansion, the lines above switch off a check. Remove them and fix the cause."

step 'Test (sanitizers on; the property test runs a fixed seed)'
if ! run ctest --preset dev >build/dev/ctest.log 2>&1; then
  cat build/dev/ctest.log
  exit 1
fi
cat build/dev/ctest.log
# A test marked DISABLED, skipped or left out by a preset filter passes ctest. It must not pass
# the check.
total=$(run ctest --test-dir build/dev -N | sed -n 's/^Total Tests: //p')
if grep -qE 'Not Run|did not run|\*\*\*Skipped' build/dev/ctest.log ||
  ! grep -qxE "100% tests passed(, 0 tests failed)? out of $total" build/dev/ctest.log; then
  fail "Not all of the $total tests ran. Every test must run."
fi

printf '\nAll checks passed.\n'
