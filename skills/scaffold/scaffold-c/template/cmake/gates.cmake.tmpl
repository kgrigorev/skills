# The project's quality gates. They apply to every target that CMakeLists.txt defines after
# including this file, so a new target cannot miss them. scripts/check reads the build's compile
# commands and requires the flags below on every project file: change both together.
# Agents: change this file only with the owner's approval.

# ctest runs each Unity test through this file in script mode (see add_unity_test). The test passes
# only when it exits 0 and its last lines are Unity's summary with at least one test, no failure
# and nothing ignored. A main that drops the result of UNITY_END, or never reaches it, fails.
if(CMAKE_SCRIPT_MODE_FILE)
  execute_process(COMMAND "${GATES_TEST}" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE output)
  message("${output}")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "The test exited with ${result}.")
  endif()
  if(output MATCHES ":FAIL" OR NOT output MATCHES "\n[1-9][0-9]* Tests 0 Failures 0 Ignored \nOK\n$")
    message(FATAL_ERROR "The test did not end with a Unity summary of passed tests only.")
  endif()
  return()
endif()

add_compile_options(
  # Implicit conversions that lose value or sign, float promoted to double by accident.
  -Wall -Wextra -Wpedantic -Wconversion -Wdouble-promotion
  # Names hiding names, undefined macros in #if, stack arrays sized at run time,
  # casts that drop const, string literals written through.
  -Wshadow -Wundef -Wvla -Wcast-qual -Wwrite-strings
  # Old-style declarations, and non-static functions or globals with no declaration in a header.
  -Wstrict-prototypes -Wmissing-prototypes -Wmissing-variable-declarations
  # printf-style format bugs, silent switch fallthrough, the comma operator used by mistake.
  -Wformat=2 -Wimplicit-fallthrough -Wcomma)
# clang-tidy and clangd must see the headers that clang sees. They read every flag from
# compile_commands.json, so each compile command names what clang finds on its own:
# - its own headers (stdarg.h, stdbool.h, ...). clang-tidy and clangd come from another package
#   and do not have them.
# - its config file, which on Linux names the pinned C library (--sysroot). Only clang reads it
#   by default.
# clang itself compiles the same way with or without these flags.
execute_process(COMMAND ${CMAKE_C_COMPILER} -print-resource-dir
  OUTPUT_VARIABLE gates_resource_dir OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
add_compile_options(-resource-dir=${gates_resource_dir})
execute_process(COMMAND ${CMAKE_C_COMPILER} --version
  OUTPUT_VARIABLE gates_compiler_version COMMAND_ERROR_IS_FATAL ANY)
if(gates_compiler_version MATCHES "Configuration file: ([^\n]+)")
  add_compile_options(--config=${CMAKE_MATCH_1})
endif()
# A warning is a failed build, so it cannot pile up unread.
set(CMAKE_COMPILE_WARNING_AS_ERROR ON)
if(GATES_CLANG_TIDY)
  # Ninja runs clang-tidy next to each compile, so only changed files are linted again.
  set(CMAKE_C_CLANG_TIDY "${GATES_CLANG_TIDY}")
endif()

# A Unity test executable. Unity exits 0 when it ran no test or ignored one, so ctest runs it
# through the script-mode block at the top of this file, which also reads the summary.
function(add_unity_test name source)
  add_executable(${name} ${source})
  target_link_libraries(${name} PRIVATE ${ARGN} unity)
  add_test(NAME ${name} COMMAND ${CMAKE_COMMAND} -DGATES_TEST=$<TARGET_FILE:${name}>
    -P ${CMAKE_CURRENT_FUNCTION_LIST_FILE})
endfunction()

# A property test: a libFuzzer target that ctest runs with a fixed seed and run count, so every run
# tries the same inputs. -rss_limit_mb=0 stops libFuzzer's memory-watch thread, which
# LeakSanitizer would report as a leak. AGENTS.md shows how to search longer for new failures.
function(add_property_test name source)
  add_executable(${name} ${source})
  target_link_libraries(${name} PRIVATE ${ARGN})
  target_compile_options(${name} PRIVATE -fsanitize=fuzzer)
  target_link_options(${name} PRIVATE -fsanitize=fuzzer)
  add_test(NAME ${name} COMMAND ${name} -seed=1 -runs=100000 -rss_limit_mb=0)
endfunction()
