#!/bin/sh
# Runs every quality gate. People, agents, the git hook and CI all run this script.
# It stops at the first failure. Agents: change it only with the owner's approval.
set -eu
cd "$(dirname "$0")/.."
root=$(pwd -P)

# mise.lock must pin the exact version of every tool in mise.toml. mise does not enforce this
# itself: for a version that the lock lacks it only warns, then may install that version and
# rewrite mise.lock. So this runs before any mise call. To change a tool: edit mise.toml, then run
# mise lock --platform macos-arm64,linux-x64,linux-arm64
# mise.toml holds only [tools] and `lockfile = true`: an [env] section could put another
# clang-tidy first on PATH, and other settings change how mise installs.
step() { printf '\n==> %s\n' "$1"; }
# The script runs twice (see `exec mise exec` below). The header prints once, so a failure here
# names its step like every other gate.
if [ -z "${SCRIPTS_CHECK_IN_MISE:-}" ]; then step 'Tools pinned by mise.toml and mise.lock'; fi
unlocked=$(awk '
  FNR == 1 { file++ }
  file == 1 && /^[[:space:]]*(#|$)/ { next }
  file == 1 && /^\[/ { section = $0; if (section != "[tools]" && section != "[settings]")
    print "mise.toml: section " section " is not allowed"; next }
  file == 1 && section == "[settings]" && $0 != "lockfile = true" {
    print "mise.toml: setting \"" $0 "\" is not allowed" }
  file == 1 && section == "[tools]" {
    key = $0; sub(/ = .*/, "", key)
    version = $0; sub(/^[^=]*= *"/, "", version); sub(/".*/, "", version)
    wanted[key " " version] = 1
  }
  file == 2 && /^\[\[tools\./ { tool = $0; sub(/^\[\[tools\./, "", tool); sub(/\]\]$/, "", tool) }
  file == 2 && /^version = / { version = $0; sub(/^version = "/, "", version); sub(/".*/, "", version)
    locked[tool " " version] = 1 }
  END { for (entry in wanted) if (!(entry in locked)) print entry " is not in mise.lock" }' \
  mise.toml mise.lock)
if [ -n "$unlocked" ]; then
  printf '%s\n' "$unlocked"
  echo 'Fix mise.toml, then run: mise lock --platform macos-arm64,linux-x64,linux-arm64' >&2
  exit 1
fi

# Every tool comes from mise.toml and mise.lock. Agent shells and git hooks often run without
# mise's PATH, so the script starts itself again inside `mise exec`, which puts the pinned tools
# first.
# mise runs only config files that the user trusts. Running this script already trusts the code
# in this folder, so it trusts the folder's mise.toml too, for this run only. A new git worktree
# then needs no `mise trust`.
# mise also reads mise.local.toml, .mise.toml, .config/mise.toml, mise.<MISE_ENV>.toml, the
# config of every parent folder and the user's global config. Any of them can change PATH or a
# tool version, so this run reads only the project's mise.toml.
if [ -z "${SCRIPTS_CHECK_IN_MISE:-}" ]; then
  if ! command -v mise >/dev/null 2>&1; then
    echo 'mise is not on PATH. Install it: https://mise.jdx.dev (see README.md).' >&2
    exit 1
  fi
  unset MISE_ENV
  MISE_TRUSTED_CONFIG_PATHS=$root MISE_OVERRIDE_CONFIG_FILENAMES=mise.toml \
    MISE_CEILING_PATHS=$(dirname "$root") MISE_GLOBAL_CONFIG_FILE=$root/build/no-mise-config.toml \
    MISE_SYSTEM_CONFIG_FILE=$root/build/no-mise-config.toml SCRIPTS_CHECK_IN_MISE=1 \
    exec mise exec --locked -- scripts/check "$@"
fi

# Settings from the caller's shell must not change the result. GoogleTest reads GTEST_* (a
# filter, disabled tests, repeats), and compilers read the flag variables.
for name in $(env | sed -n 's/^\(GTEST_[A-Z_]*\)=.*/\1/p'); do unset "$name"; done
unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS

# Each tool must be the one mise.toml pins, not one that comes earlier on PATH.
for entry in cmake:cmake cmake:ctest ninja:ninja conda:clangxx:clang++ \
  conda:clang-tools:clang-tidy conda:clang-format:clang-format; do
  tool=${entry##*:}
  found=$(command -v "$tool" || true)
  case $found in
    "$(mise where "${entry%:*}")"/*) ;;
    *)
      echo "$tool on PATH is '$found', not the one mise.toml pins." >&2
      exit 1
      ;;
  esac
done

# Lists the project's files that match the given patterns, tracked or new. Deleted files are
# skipped.
project_files() {
  git ls-files --cached --others --exclude-standard -- "$@" |
    while read -r file; do if [ -e "$file" ]; then printf '%s\n' "$file"; fi; done
}
cpp_files=$(project_files '*.cpp' '*.hpp')
cmake_files=$(project_files '*CMakeLists.txt' '*.cmake' 'CMakePresets.json')

# A version mismatch explains a local-vs-CI difference. On macOS the C library headers come from
# the installed Command Line Tools SDK, which mise cannot pin. Each command runs on its own, so
# a missing tool stops the check here.
version() { output=$("$@"); printf '%s\n' "$output" | grep -m 1 -i 'version'; }
version clang++ --version
version clang-tidy --version
version clang-format --version
version cmake --version
echo "ninja $(ninja --version)"
mise_version=$(mise --version 2>/dev/null | sed 's/ .*//')
echo "mise $mise_version"
if [ "$(uname -s)" = Darwin ]; then echo "macOS SDK $(xcrun --show-sdk-version)"; fi
# CI runs the mise version below. An older one may read mise.toml or mise.lock differently.
if ! printf '%s\n' "$mise_version" | awk -F . -v pinned='{{mise_version}}' '{
  split(pinned, want, "."); for (i = 1; i <= 3; i++) if ($i + 0 != want[i] + 0) exit !($i + 0 > want[i] + 0)
  exit 0 }'; then
  echo 'mise is older than {{mise_version}}, the version CI runs. Run: mise self-update' >&2
  exit 1
fi

step 'Only .cpp and .hpp files'
# The format, lint and switch-off gates read .cpp and .hpp files only, so a file with another
# extension, in any letter case, would skip them.
other_sources=$(project_files ':(icase)*.c' ':(icase)*.cc' ':(icase)*.cpp' ':(icase)*.cxx' \
  ':(icase)*.c++' ':(icase)*.cp' ':(icase)*.h' ':(icase)*.hh' ':(icase)*.hpp' ':(icase)*.hxx' \
  ':(icase)*.h++' ':(icase)*.ipp' ':(icase)*.inl' ':(icase)*.inc' ':(icase)*.def' \
  ':(icase)*.tpp' ':(icase)*.txx' ':(icase)*.ixx' ':(icase)*.cppm' ':(icase)*.mpp' \
  ':(icase)*.cu' ':(icase)*.m' ':(icase)*.mm' | grep -vE '\.(cpp|hpp)$' || true)
if [ -n "$other_sources" ]; then
  printf '%s\n' "$other_sources"
  echo 'Rename the files above to .cpp (source) or .hpp (header).' >&2
  exit 1
fi
if [ -z "$cpp_files" ]; then
  echo 'No .cpp or .hpp files found.' >&2
  exit 1
fi

step 'Format (clang-format, rules in .clang-format). Fix: scripts/format'
# shellcheck disable=SC2086 # file names have no spaces
clang-format --dry-run --Werror $cpp_files

step 'No switched-off checks'
# Comments, pragmas, attributes, macros, flags and test settings that switch off a check or a
# test. Flags that reach the compiler are checked again after the configure step.
failed=''
# Comments that switch off clang-tidy or clang-format, in any file.
# shellcheck disable=SC2086 # file names have no spaces
if grep -nE 'NOLINT|clang-format (off|on)' $cpp_files $cmake_files; then
  echo 'The comments above switch off clang-tidy or clang-format. Remove them and fix the cause.' >&2
  failed=1
fi
# CMake settings and compiler flags that switch off a warning, a sanitizer or a test.
cmake_words='COMPILE_WARNING_AS_ERROR|GTEST_SKIP|DISABLED|WILL_FAIL|SKIP_RETURN_CODE'
cmake_words="$cmake_words|SKIP_REGULAR_EXPRESSION|TEST_FILTER|gtest_filter|no_sanitize"
cmake_words="$cmake_words|-Wno-|(^|[[:space:]\"])-w([[:space:]\")]|\$)|--no-warnings"
cmake_words="$cmake_words|-fno-sanitize=|-fsanitize-(ignorelist|blacklist)"
# shellcheck disable=SC2086
# -e: the pattern starts with "-", which grep would read as an option.
if grep -nE -e "$cmake_words" $cmake_files; then
  echo 'The CMake lines above switch off a check or a test. Remove them and fix the cause.' >&2
  failed=1
fi

# The C++ code without comments and without the text of string and character literals, one
# "file:line: code" line per logical line (a line ended by a backslash is joined to the next, as
# the compiler does). The searches below read it, so a word in a comment or a string, such as
# the option "-w" or a note about NDEBUG, is not flagged, and a comment cannot split a word
# (#/**/pragma). They read code, not what it means: a macro could still build a word from parts,
# so token pasting (##) is rejected too.
mkdir -p build/check
code=build/check/code.txt
# shellcheck disable=SC2086
awk -v apostrophe="'" '
  function blank(count,   out) { out = ""; while (count-- > 0) out = out " "; return out }
  function strip(line,   n, i, c, out, word, rest, at) {
    n = length(line); out = ""; word = ""; i = 1
    while (i <= n) {
      c = substr(line, i, 1)
      if (state == "block") {
        if (substr(line, i, 2) == "*/") { out = out "  "; i += 2; state = "code" } else { out = out " "; i++ }
      } else if (state == "raw") {
        at = index(substr(line, i), raw_end)
        if (at == 0) { out = out blank(n - i + 1); i = n + 1 }
        else { out = out blank(at - 1) raw_end; i += at - 1 + length(raw_end); state = "code" }
      } else if (state == "string" || state == "char") {
        if (c == "\\") { out = out "  "; i += 2 }
        else if (c == quote) { out = out c; i++; state = "code" }
        else { out = out " "; i++ }
      } else if (substr(line, i, 2) == "//") { out = out blank(n - i + 1); i = n + 1
      } else if (substr(line, i, 2) == "/*") { out = out "  "; i += 2; state = "block"; word = ""
      } else if (c == "\"" && word ~ /^(u8|u|U|L)?R$/ && (at = index(substr(line, i + 1), "(")) > 0) {
        # A raw string literal R"delimiter( ... )delimiter", which may span lines.
        raw_end = ")" substr(line, i + 1, at - 1) "\""; out = out c blank(at); i += at + 1
        state = "raw"; word = ""
      } else if (c == "\"" || (c == apostrophe && word !~ /^[0-9]/)) {
        # An apostrophe after a digit is a digit separator, not a character literal.
        quote = c; out = out c; i++; state = (c == "\"") ? "string" : "char"; word = ""
      } else {
        out = out c; i++
        if (c ~ /[A-Za-z0-9_.]/ || c == apostrophe) word = word c; else word = ""
      }
    }
    # A string or character literal ends at the end of its line.
    if (state == "string" || state == "char") state = "code"
    return out
  }
  function emit() { if (pending != "") print file ":" first ": " strip(pending); pending = "" }
  FNR == 1 { emit(); state = "code"; file = FILENAME }
  {
    if (pending == "") first = FNR
    line = $0
    if (line ~ /\\$/) { pending = pending substr(line, 1, length(line) - 1); next }
    pending = pending line; if (pending == "") pending = " "
    emit()
  }
  END { emit() }' $cpp_files >"$code"

# Pragmas switch off warnings or change the compiler's settings for part of a file. Only
# `#pragma once` is allowed.
if grep -E '(^|[^A-Za-z0-9_])(_Pragma|__pragma|pragma)([^A-Za-z0-9_]|$)' "$code" |
  grep -vE '^[^:]*:[0-9]+: [[:space:]]*(#|%:)[[:space:]]*pragma[[:space:]]+once[[:space:]]*$'; then
  echo 'The pragmas above are not allowed. Only #pragma once is.' >&2
  failed=1
fi
# Attributes and sanitizer calls that switch off a check or a sanitizer, test settings that skip
# a test, and macros that tell the checked build apart from others, so code under them is never
# compiled, linted or tested here. clang-tidy defines __clang_analyzer__, and __BASE_FILE__ names
# the file being compiled, so a header can act differently in a test. RC_SUCCEED ends a property
# before its assertions. GTEST_FLAG sets a GoogleTest flag, such as a filter, from code.
code_words='(^|[^A-Za-z0-9_])_*suppress_*([^A-Za-z0-9_]|$)|no_sanitize|no_address_safety_analysis'
code_words="$code_words|disable_sanitizer_instrumentation|__(a|ub|l|m|t|hwa)san(_|::)|__sanitizer_"
code_words="$code_words|GTEST_SKIP|DISABLED|GTEST_FLAG|FLAGS_gtest_|gtest_filter|RC_SUCCEED"
code_words="$code_words|__clang_analyzer__|__has_feature|__SANITIZE_|NDEBUG|_LIBCPP_|_GLIBCXX_"
code_words="$code_words|__BASE_FILE__|__OPTIMIZE__|##|%:%:"
if grep -E "$code_words" "$code"; then
  echo 'The lines above switch off a check or a test. Remove them and fix the cause.' >&2
  failed=1
fi
# Ending the process skips the test framework's report and the caller's error handling. Return
# an error or throw instead (std::exit is caught by clang-tidy's concurrency-mt-unsafe).
if grep -E '(^|[^A-Za-z0-9_.>])(std::|::)?(abort|terminate|quick_exit|_Exit|_exit)[[:space:]]*\(' "$code"; then
  echo 'The lines above end the process. Return an error or throw instead.' >&2
  failed=1
fi
# #if, #ifdef and #elif may test only the platform (__APPLE__, __linux__), the language and
# library features (__cplusplus, __cpp_*) and __has_include. Code under any other macro is
# compiled in other builds only, and a condition without a macro (#if 0) is never compiled.
# defined() and __has_include() arguments are not macros of their own.
bad_conditions=$(awk '
  {
    code = $0; sub(/^[^:]*:[0-9]+: /, "", code)
    if (code !~ /^[[:space:]]*(#|%:)[[:space:]]*(if|ifdef|ifndef|elif|elifdef|elifndef)([^A-Za-z0-9_]|$)/) next
    sub(/^[[:space:]]*(#|%:)[[:space:]]*[a-z]+/, "", code)
    gsub(/__has_(include|include_next|cpp_attribute)[[:space:]]*\([^)]*\)/, " 1 ", code)
    macros = 0; bad = ""
    while (match(code, /[A-Za-z_][A-Za-z0-9_]*|[0-9][A-Za-z0-9_.]*/)) {
      token = substr(code, RSTART, RLENGTH); code = substr(code, RSTART + RLENGTH)
      if (token ~ /^[0-9]/ || token == "true" || token == "false" || token == "defined") continue
      macros++
      if (token !~ /^(__APPLE__|__linux__|__cplusplus|__cpp_[a-z0-9_]+)$/) bad = bad " " token
    }
    if (bad != "") print $0 "   <- tests" bad
    else if (macros == 0) print $0 "   <- has no macro, so it never changes"
  }' "$code")
if [ -n "$bad_conditions" ]; then
  printf '%s\n' "$bad_conditions"
  echo 'Test only __APPLE__, __linux__, __cplusplus, __cpp_* or __has_include in #if. Headers use #pragma once.' >&2
  failed=1
fi
# Test files are the files that include GoogleTest or rapidcheck. In them, main comes from
# GoogleTest (a main of their own can ignore the result), and a bare `return;` ends a test before
# its assertions. A property skips an input with RC_PRE, which fails it when too many are skipped.
# shellcheck disable=SC2086
test_files=$(grep -lE '^[[:space:]]*#[[:space:]]*include[[:space:]]*[<"](gtest|gmock|rapidcheck)/' $cpp_files || true)
if [ -n "$test_files" ] && TEST_FILES=$test_files awk '
  BEGIN { n = split(ENVIRON["TEST_FILES"], list, "\n"); for (i = 1; i <= n; i++) test[list[i]] = 1 }
  { file = $0; sub(/:.*/, "", file) }
  (file in test) && /(^|[^A-Za-z0-9_])(return[[:space:]]*;|main[[:space:]]*\()/ { print; found = 1 }
  END { exit !found }' "$code"; then
  echo 'Test files may not define main or use a bare return. Skip a property input with RC_PRE.' >&2
  failed=1
fi
# clang-tidy and clang-format use the nearest config file, so one in a subfolder overrides the
# root one.
extra_configs=$(project_files '*.clang-tidy' '*.clang-format' '*_clang-format' |
  grep -vxE '\.clang-(tidy|format)' || true)
if [ -n "$extra_configs" ]; then
  printf '%s\n' "$extra_configs"
  echo 'Remove the files above: only the root .clang-tidy and .clang-format apply.' >&2
  failed=1
fi
if [ -n "$failed" ]; then exit 1; fi

step 'Dependencies pinned by URL and SHA-256'
# Other ways to fetch code (git, ExternalProject, file(DOWNLOAD), a local source folder) give
# whatever the server or the folder has today. A library from the machine (find_package) is
# caught after the build, by its path.
# The scan reads CMake as CMake does: it drops # and #[[ ]] comments outside quotes, joins each
# command over its lines up to the closing parenthesis, and matches command names in any letter
# case (CMake ignores it there; keywords such as URL are case-sensitive).
# shellcheck disable=SC2086
cmake_scripts=$(printf '%s\n' $cmake_files | grep -v '\.json$')
# shellcheck disable=SC2086
unpinned=$(awk '
  function end_word() {
    if (word == "" && !quoted) return
    if (depth == 0) name = word; else args[++count] = word
    word = ""; quoted = 0
  }
  function command(   i, url, hash) {
    if (name ~ /^(externalproject_|fetchcontent_populate$|cpm)/ ||
      (name == "include" && args[1] ~ /^(ExternalProject|CPM)/) ||
      (name == "file" && args[1] == "DOWNLOAD") ||
      (name == "set" && args[1] ~ /^FETCHCONTENT_(SOURCE_DIR_|TRY_FIND_PACKAGE_MODE)/)) {
      print FILENAME ":" start ": " name " fetches code without a pinned URL and SHA-256"; return }
    if (name != "fetchcontent_declare") return
    url = 0; hash = 0
    for (i = 2; i <= count; i++) {
      if (args[i] == "URL" && args[i + 1] ~ /^https:\/\//) url = 1
      if (args[i] == "URL_HASH" && args[i + 1] ~ /^SHA256=[0-9a-f]+$/ && length(args[i + 1]) == 71) hash = 1
      if (args[i] ~ /^(GIT_|SVN_|HG_|CVS_|SOURCE_DIR$|DOWNLOAD_COMMAND$|PATCH_COMMAND$|UPDATE_COMMAND$|FIND_PACKAGE_ARGS$|OVERRIDE_FIND_PACKAGE$)/) {
        url = 0; break }
    }
    if (!url || !hash)
      print FILENAME ":" start ": FetchContent_Declare needs URL https://... and URL_HASH SHA256=... only"
  }
  FNR == 1 { mode = "code"; depth = 0; word = ""; quoted = 0; name = "" }
  {
    line = $0; n = length(line); i = 1
    while (i <= n) {
      c = substr(line, i, 1)
      if (mode == "bracket") {
        at = index(substr(line, i), bracket_end)
        if (at == 0) { if (!comment) word = word substr(line, i) "\n"; i = n + 1; continue }
        if (!comment) { word = word substr(line, i, at - 1); quoted = 1 }
        i += at - 1 + length(bracket_end); mode = "code"; if (!comment) end_word(); continue
      }
      if (mode == "string") {
        if (c == "\\") { word = word substr(line, i, 2); i += 2; continue }
        if (c == "\"") { mode = "code"; i++; end_word(); continue }
        word = word c; i++; continue
      }
      if (c == "#") {
        if (match(substr(line, i + 1), /^\[=*\[/)) {
          bracket_end = "]" substr(line, i + 2, RLENGTH - 2) "]"; mode = "bracket"; comment = 1
          i += 1 + RLENGTH; continue }
        break
      }
      if (c == "[" && word == "" && match(substr(line, i), /^\[=*\[/)) {
        bracket_end = "]" substr(line, i + 1, RLENGTH - 2) "]"; mode = "bracket"; comment = 0
        i += RLENGTH; continue }
      if (c == "\"" && word == "") { mode = "string"; quoted = 1; i++; continue }
      if (c == "\\") { word = word substr(line, i, 2); i += 2; continue }
      if (c == "(") {
        end_word()
        if (depth == 0) { name = tolower(name); start = FNR; count = 0; delete args }
        depth++; i++; continue
      }
      if (c == ")") {
        end_word(); i++
        if (depth > 0 && --depth == 0) { command(); name = "" }
        continue
      }
      if (c == " " || c == "\t") { end_word(); i++; continue }
      word = word c; i++
    }
    if (mode == "string") word = word "\n"; else if (mode == "code") end_word()
  }' $cmake_scripts)
if [ -n "$unpinned" ]; then
  printf '%s\n' "$unpinned"
  echo 'Pin each dependency in cmake/dependencies.cmake by URL and SHA-256.' >&2
  exit 1
fi

step 'Configure (CMakePresets.json, preset dev)'
cmake --preset dev --log-level=WARNING
# What the compiler really gets for each file it compiles. Every project file must get the
# -W flags in cmake/strict.cmake and the sanitizer and hardening flags in CMakePresets.json,
# and no flag outside the list below. The list closes every way to switch a check off from
# CMake: -Wno-*, -U, -DNDEBUG, response files (@file), system-header paths, force-included
# files. Only GoogleTest and rapidcheck under build/dev/_deps are system headers. This also
# catches a flag passed once by hand (cmake -D...), which stays in the build folder's cache.
# Adding a flag to the list needs the owner's approval.
# Every compiled file must be a .cpp file that the gates above read.
# Every project file gets the same -D macros, so a header cannot act differently in the tests
# (a macro set for the test target only) than in the program.
bad_commands=$(CPP_FILES=$cpp_files awk -v root="$root/" -v compiler="$(mise where conda:clangxx)/" '
  function literal(text, from, to,   at, out) {
    out = ""
    while ((at = index(text, from)) > 0) { out = out substr(text, 1, at - 1) to; text = substr(text, at + length(from)) }
    return out text
  }
  function bad(why) { print file ": " why }
  BEGIN {
    n = split(ENVIRON["CPP_FILES"], list, "\n"); for (i = 1; i <= n; i++) checked[list[i]] = 1
    split("-std=c++23 -fsanitize=address,undefined -fno-sanitize-recover=all " \
      "-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_DEBUG -D_GLIBCXX_ASSERTIONS", fixed, " ")
    for (i in fixed) required[fixed[i]] = 1
    split("-g -pthread -fPIC -fPIE -fno-omit-frame-pointer -fcolor-diagnostics " \
      "-fdiagnostics-color=always -MD", plain, " ")
    for (i in plain) allowed[plain[i]] = 1
    for (w in required) allowed[w] = 1
  }
  FNR == 1 { part++ }
  part == 1 { sub(/#.*/, ""); gsub(/[()]/, " ")
    for (i = 1; i <= NF; i++) if ($i ~ /^-W/) { required[$i] = 1; allowed[$i] = 1 }
    next }
  /"command":/ { command = literal($0, root, "@/") }
  /"file":/ {
    file = literal($0, root, "@/"); sub(/^ *"file": "/, "", file); sub(/",?$/, "", file)
    if (index(file, "@/build/dev/_deps/") == 1) next
    if (index(file, "@/") != 1 || !(substr(file, 3) in checked) || file !~ /\.cpp$/)
      bad("is compiled, but it is not a .cpp file of the project that the gates above read")
    line = command; sub(/^ *"command": "/, "", line); sub(/",?$/, "", line)
    n = split(line, word, " ")
    if (index(word[1], compiler) != 1) bad("is compiled by " word[1] ", not the pinned clang++")
    delete seen
    for (i = 2; i <= n; i++) {
      w = word[i]; seen[w] = 1
      if (w == "-o" || w == "-c" || w == "-arch" || w == "-MT" || w == "-MF") { i++; continue }
      if (w == "-isystem") { i++; if (index(word[i], "@/build/dev/_deps/") != 1)
        bad("treats " word[i] " as system headers, which are not checked"); continue }
      if (w == "-isysroot") { i++; if (index(word[i], "@/") == 1) bad("uses " word[i] " as the SDK"); continue }
      if (w ~ /^-I/) { path = substr(w, 3); if (path == "") path = word[++i]
        if (index(path, "@/") != 1 || path ~ /(^|\/)\.\.(\/|$)/)
          bad("reads headers from " path ", outside the project")
        continue }
      if (w ~ /^-D/) { name = substr(w, 3); sub(/=.*/, "", name)
        if (!(w in required) && (name == "NDEBUG" || name ~ /^_[_A-Z]/))
          bad("defines " name ", which changes the checks or the standard library")
        continue }
      if (w ~ /^-W[a-z][a-z0-9=+-]*$/ && w !~ /^-Wno-/) continue
      if (w ~ /^-resource-dir=|^-mmacosx-version-min=|^-O[0-3sgz]?$/ || (w in allowed)) continue
      bad("gets " w ", which is not on the list of flags in scripts/check")
    }
    for (w in required) if (!(w in seen)) bad("is compiled without " w)
    files++; for (w in seen) if (w ~ /^-D/ && !(w in required)) defines[w]++
  }
  END { for (w in defines) if (defines[w] != files)
    print w ": is set for some project files only. Set it for every target or for none" }
  ' cmake/strict.cmake build/dev/compile_commands.json)
if [ -n "$bad_commands" ]; then
  printf '%s\n' "$bad_commands" | sed 's|@/||g' | sort -u
  echo 'Fix CMakeLists.txt, or clear a flag passed by hand: rm -rf build/dev' >&2
  exit 1
fi
# A compiler launcher runs before the compiler and can change its flags.
if grep -nE '^  LAUNCHER = .' build/dev/build.ninja; then
  echo 'Remove the compiler launcher (CMAKE_CXX_COMPILER_LAUNCHER or the target property).' >&2
  exit 1
fi

step 'Lint (clang-tidy, rules in .clang-tidy)'
# One clang-tidy per source file, as many at once as the machine has cores. Headers are checked
# through the source files that include them.
# In test files, bugprone-unchecked-optional-access is off: it does not see that
# ASSERT_TRUE(value.has_value()) ends the test, so it rejects the usual GoogleTest code. Every
# line of a test runs in the check, and the hardened standard library stops a bad access there.
lint() { xargs -r -P "$(getconf _NPROCESSORS_ONLN)" -n 1 clang-tidy -p build/dev --quiet --warnings-as-errors='*' "$@"; }
# shellcheck disable=SC2086
printf '%s\n' $cpp_files | grep -E '\.cpp$' | grep -vxF "${test_files:-/}" | lint
printf '%s\n' "$test_files" | grep -E '\.cpp$' | lint --checks=-bugprone-unchecked-optional-access

step 'Build (warnings are errors)'
cmake --build --preset dev

step 'Every project file is compiled, and the compiler reads only checked files'
# ninja records each file that the compiler read for an object. A file the gates above skip
# (an included .inc, an untracked header) must not reach the compiler, and a .cpp or .hpp that
# nothing compiles is never linted or tested.
not_checked=$(ninja -C build/dev -t deps | CPP_FILES=$cpp_files awk -v root="$root/" '
  BEGIN { n = split(ENVIRON["CPP_FILES"], list, "\n"); for (i = 1; i <= n; i++) checked[list[i]] = 1 }
  /^[^ ]/ { own = ($0 !~ /^_deps\//); next }
  own && /^    / { path = $0; sub(/^    /, "", path)
    if (index(path, root) != 1) next
    path = substr(path, length(root) + 1)
    if (path ~ /^build\//) next
    read[path] = 1
    if (!(path in checked)) print path ": the compiler reads it, but the gates above do not" }
  END { for (path in checked) if (!(path in read))
    print path ": nothing compiles it. Add it to CMakeLists.txt or delete it" }')
if [ -n "$not_checked" ]; then
  printf '%s\n' "$not_checked" | sort
  exit 1
fi
# Libraries come from cmake/dependencies.cmake and are built here. A library from the machine
# (find_package, -lz, an absolute path) builds on one machine and not on another. The C library
# parts below belong to the pinned toolchain.
bad_links=$(awk '
  /^build / { output = $2; sub(/:$/, "", output)
    own = ($3 ~ /^CXX_(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)_LINKER/ && output !~ /^_deps\//); next }
  own && /^  (LINK_LIBRARIES|LINK_PATH) = / {
    for (i = 3; i <= NF; i++)
      if ($i ~ /^(-L|-F|-framework$|\/|\.\.)/ || ($i ~ /^-/ && $i !~ /^-l(pthread|dl|m|rt)$|^-pthread$/))
        print output ": links " $i }
  own && /^  LINK_FLAGS = / {
    for (i = 3; i <= NF; i++) if ($i ~ /^(-l|-L|-F|-framework$|\/)|^-Wl,.*(-l|-L|\/)/) print output ": links " $i }
  ' build/dev/build.ninja)
if [ -n "$bad_links" ]; then
  printf '%s\n' "$bad_links"
  echo 'Fetch the library in cmake/dependencies.cmake, after the owner approves it.' >&2
  exit 1
fi

step 'Test (sanitizers on, fixed property seed)'
# Every ctest test must be one GoogleTest case run as gtest_discover_tests writes it. Test
# properties (PASS_REGULAR_EXPRESSION, ENVIRONMENT, WILL_FAIL, ...) and custom add_test
# commands can make a failing test pass.
# A CTestCustom file in the build folder can tell ctest to skip tests, and it outlives the CMake
# code that wrote it. The check below would catch the skip; deleting the file stops a revert from
# leaving the build folder broken.
rm -f build/dev/CTestCustom.cmake build/dev/CTestCustom.ctest
ctest --test-dir build/dev --show-only=json-v1 >build/dev/tests.json
bad_tests=$(awk -v binary="$root/build/dev/" '
  /^      "command" : *$/ { in_command = 1; n = 0; next }
  in_command && /^      \]/ { in_command = 0
    if (n != 3 || index(arg[1], binary) != 1 || arg[2] !~ /^--gtest_filter=/ ||
      arg[3] != "--gtest_also_run_disabled_tests")
      print "test " tests + 1 ": runs something other than one GoogleTest case"
    next }
  in_command && /^        "/ { value = $0; sub(/^ *"/, "", value); sub(/",?$/, "", value); arg[++n] = value; next }
  /^      "name" : / { tests++ }
  /^          "name" : / { name = $0; sub(/^ *"name" : "/, "", name); sub(/",?$/, "", name)
    if (name !~ /^(SKIP_REGULAR_EXPRESSION|WORKING_DIRECTORY|DEF_SOURCE_LINE)$/)
      print "test " tests ": sets the test property " name }
  END { print "count " tests + 0 }' build/dev/tests.json)
if printf '%s\n' "$bad_tests" | grep -v '^count '; then
  echo 'Remove the test properties and custom tests above from CMakeLists.txt.' >&2
  exit 1
fi
# The tests each test executable holds, as the executable itself lists them, without the
# arguments, flag files or filters that discovery may pass. A test executable is any project
# executable that links GoogleTest. Each must hold at least one test, so one with its own main
# cannot list nothing and run nothing.
test_binaries=$(awk '
  /^build / { output = $2; sub(/:$/, "", output)
    executable = ($3 ~ /^CXX_EXECUTABLE_LINKER/ && output !~ /^_deps\//); next }
  executable && /^  LINK_LIBRARIES = / {
    for (i = 3; i <= NF; i++) if ($i ~ /(^|\/)libgtest(_main)?[^\/]*\.a$/) { print output; next } }
  ' build/dev/build.ninja | sort -u)
listed=''
for binary in $test_binaries; do
  if ! list=$("build/dev/$binary" --gtest_list_tests --gtest_also_run_disabled_tests); then
    echo "build/dev/$binary --gtest_list_tests failed." >&2
    exit 1
  fi
  names=$(printf '%s\n' "$list" | awk '
    /^[^ ]/ { suite = $1; listing = sub(/\.$/, "", suite); next }
    listing && /^  [^ ]/ { print suite "." $1 }')
  if [ -z "$names" ]; then
    echo "build/dev/$binary links GoogleTest but lists no tests. Use GTest::gtest_main." >&2
    exit 1
  fi
  listed="$listed$names
"
done
# Each test writes a JSON report when it finishes, so a test that ends the process early, or
# whose exit code was changed, has no passing report. ctest runs one test at a time, so each
# report gets its own file name.
rm -rf build/dev/gtest
mkdir build/dev/gtest
unset CTEST_PARALLEL_LEVEL
GTEST_OUTPUT="json:$root/build/dev/gtest/" ctest --preset dev --output-log build/dev/ctest.log
# ctest passes when a test is skipped or disabled; here that is a failure.
if grep -A 1000 'tests did not run' build/dev/ctest.log; then
  echo 'Every test must run. Remove the skip or the DISABLED setting, or delete the test.' >&2
  exit 1
fi
# The preset may not filter tests out.
defined=$(printf '%s\n' "$bad_tests" | sed -n 's/^count //p')
ran=$(sed -n 's/.*tests passed.* out of \([0-9]*\)$/\1/p' build/dev/ctest.log)
if [ "$ran" != "$defined" ]; then
  echo "ctest ran ${ran:-no} tests out of $defined. Remove the filter from CMakePresets.json." >&2
  exit 1
fi
# Every listed test must have a report that says it ran to the end without a failure.
passed=$(find build/dev/gtest -name '*.json' -exec awk '
  function value(   text) { text = $0; sub(/^ *"[a-z]+": "?/, "", text); sub(/"?,?$/, "", text)
    gsub(/\\\//, "/", text); return text }
  function report() { if (clean) for (i = 1; i <= n; i++) if (done[i]) print test[i]; n = 0 }
  FNR == 1 { report(); clean = 1 }
  /^  "(failures|errors)": / && value() != "0" { clean = 0 }
  /^      "name": / { suite = value() }
  /^          "name": / { test[++n] = suite "." value(); status = ""; done[n] = 0 }
  /^          "status": / { status = value() }
  /^          "result": / { done[n] = (status == "RUN" && value() == "COMPLETED") }
  /^          "failures": / { done[n] = 0 }
  END { report() }' {} +)
not_passed=$(printf '%s' "$listed" | PASSED=$passed awk '
  BEGIN { n = split(ENVIRON["PASSED"], list, "\n"); for (i = 1; i <= n; i++) passed[list[i]]++ }
  $0 != "" && passed[$0]-- <= 0 { print $0 ": did not run to the end and pass" }')
if [ -n "$not_passed" ]; then
  printf '%s\n' "$not_passed"
  echo 'Each test above must run under ctest and pass. Register every test executable with' >&2
  echo 'gtest_discover_tests, without extra arguments, and do not end the process in a test.' >&2
  exit 1
fi

printf '
All checks passed.
'
