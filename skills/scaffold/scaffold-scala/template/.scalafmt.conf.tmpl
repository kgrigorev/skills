# Formatting rules. scripts/check fails on any file scalafmt would change.
# Fix: scripts/format
# Agents: change this file only with the owner's approval.
# scala-cli downloads exactly this scalafmt version, so every machine formats alike.
version = 3.11.5
runner.dialect = scala3
maxColumn = 100
# Scala 3 syntax: `if x then`, indentation instead of braces, `*` imports.
rewrite.scala3.convertToNewSyntax = true
rewrite.scala3.removeOptionalBraces = yes
rewrite.rules = [RedundantBraces, RedundantParens, SortModifiers, Imports]
# Sorted, grouped imports, so the import order never shows up in a review.
rewrite.imports.sort = ascii
rewrite.imports.groups = [["java\\..*", "javax\\..*"], ["scala\\..*"]]
docstrings.style = Asterisk
