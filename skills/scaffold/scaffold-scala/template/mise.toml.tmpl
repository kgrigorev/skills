# Tools for {{package}}. scripts/check and CI run exactly these versions.
# To bump a tool: change its version here, run `mise lock`, and commit mise.lock with it.
# scripts/check fails when mise.lock holds another version.
# Agents: change this file only with the owner's approval.
min_version = "2026.11.8"

[settings]
# Writes mise.lock with each tool's download URL and checksum. CI installs with --locked.
lockfile = true

[tools]
# JDK that compiles, runs and tests the code. 25 is the current LTS.
java = "temurin-25.0.5+8.0.LTS"
# Compiles, runs, tests and formats the Scala code. The Scala version is in project.scala.
scala-cli = "1.19.0"
