#!/bin/sh
# Runs every quality gate. People, agents, the git hook and CI all run this script.
# It stops at the first failure. Agents: change it only with the owner's approval.
set -eu
cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$1"; }
fail() {
  echo "$1" >&2
  exit 1
}

# The tool checks are steps like the others, so a failure there names where it stopped. This
# header is printed once, before the re-run through mise below, which repeats these two checks.
[ -n "${CHECK_UNDER_MISE:-}" ] || step 'Tool pins in mise.toml and mise.lock'

# mise.toml holds only these line shapes, so the lock check below reads every tool pin. Another
# TOML form, such as `java = { version = "..." }` or `tools.java = "..."`, would escape it.
mise_shapes='^$|^#.*$|^min_version = "[0-9.]+"$|^\[settings\]$|^lockfile = true$|^\[tools\]$|^[a-z0-9-]+ = "[^"]+"$'
if grep -nvE "$mise_shapes" mise.toml; then
  fail 'mise.toml allows only comments, min_version, [settings] with lockfile = true, and [tools] with name = "version" lines.'
fi

# mise.lock must hold the exact tool versions in mise.toml. Otherwise CI, which installs from
# mise.lock, would run other tools than this machine. This runs before mise, which could
# install the new version and hide the difference.
lock_drift=$(awk '
  FNR == 1 { file++ }
  file == 1 && /^\[/ { in_tools = ($0 == "[tools]"); next }
  file == 1 && in_tools && /^[a-z0-9-]+ *= *"/ { split($0, part, "\""); want[$1] = part[2]; next }
  file == 2 && /^\[\[tools\./ { tool = $0; gsub(/^\[\[tools\.|\]\]$/, "", tool); next }
  file == 2 && /^version = "/ { split($0, part, "\""); have[tool] = part[2] }
  END { for (name in want) if (have[name] != want[name]) print name }
' mise.toml mise.lock)
if [ -n "$lock_drift" ]; then
  printf '%s\n' "$lock_drift" >&2
  fail 'mise.lock does not match mise.toml for the tools above. Run: mise lock, and commit mise.lock.'
fi

# A MISE_<TOOL>_VERSION variable picks another version than mise.toml. Whether mise would then
# refuse it depends on what this machine has installed, so refuse it here, on every machine.
tool_overrides=$(env | sed -n 's/^\(MISE_[A-Z0-9_]\{1,\}_VERSION\)=.*/\1/p')
if [ -n "$tool_overrides" ]; then
  printf '%s\n' "$tool_overrides" >&2
  fail 'Unset the variables above: only mise.toml picks tool versions.'
fi

# The JDK and Scala CLI versions live in mise.toml. Agent shells and git hooks do not activate
# mise, so the script runs itself again through `mise exec`, which puts those exact versions first
# on PATH and sets JAVA_HOME. --locked takes download URLs only from mise.lock. The absolute
# path keeps this working after the `cd` above.
if [ -z "${CHECK_UNDER_MISE:-}" ]; then
  if ! command -v mise >/dev/null 2>&1; then
    fail 'mise is not on PATH. Install it as README.md says, then run: mise install'
  fi
  CHECK_UNDER_MISE=1 exec mise exec --locked -- "$PWD/scripts/check" "$@"
fi

# munit fails any test marked .only when CI=true, so a focused test cannot hide the others.
export CI=true
# munit lets tests tagged Flaky fail when this is set.
unset MUNIT_FLAKY_OK

step 'Tools that run match mise.toml'
# Printed in the re-run, or when CHECK_UNDER_MISE was set from outside and the re-run skipped.
# mise reads more files than mise.toml: mise.local.toml, .mise.toml, .config/mise.toml,
# mise.<env>.toml, .tool-versions and others. Such a file can pick other tools, put its own
# scala-cli first on PATH or set variables that the JVM reads, and the shape check above never
# sees it. So ask mise which files it loaded, and allow only mise.toml inside this project.
root=$(pwd -P)
project_configs() {
  mise config ls --json | sed -n 's/^ *"path": "\(.*\)",*$/\1/p' | while read -r path; do
    case $path in
    "$PWD/mise.toml" | "$root/mise.toml") ;;
    "$PWD"/* | "$root"/*) printf '%s\n' "$path" ;;
    esac
  done
}
extra_configs=$(project_configs)
if [ -n "$extra_configs" ]; then
  printf '%s\n' "$extra_configs" >&2
  fail 'mise reads the files above besides mise.toml. Remove them: only mise.toml sets up the tools.'
fi
# The scala-cli and java that run must be the files mise installed, not a script earlier on PATH.
# Symlinked folders are resolved first: on CI, PATH reaches a tool through installs/<tool>/latest.
physical() { [ -n "$1" ] && (cd -P "$(dirname "$1")" && printf '%s/%s\n' "$PWD" "${1##*/}"); }
for tool in scala-cli java; do
  [ "$(physical "$(command -v "$tool" || true)" || true)" = "$(physical "$(mise which "$tool")")" ] ||
    fail "$(command -v "$tool") runs, not the $tool that mise installed ($(mise which "$tool")). Remove what changes PATH."
done
# mise.local.toml, .tool-versions or a MISE_<TOOL>_VERSION variable can still change what
# `mise exec` picks, and mise falls back to the machine's java when a version is not in mise.lock.
# So compare the tools that run now with mise.toml. The JDK pin must be a temurin-X.Y.Z+B one.
pinned() { sed -n "s/^$1 = \"\(.*\)\"\$/\1/p" mise.toml; }
scala_cli_version=$(scala-cli version --cli-version)
java_version=$(java -version 2>&1)
java_build=$(pinned java | sed -E 's/^temurin-([0-9.]+[+][0-9]+).*/Temurin-\1/')
[ "$scala_cli_version" = "$(pinned scala-cli)" ] ||
  fail "scala-cli $scala_cli_version runs, but mise.toml pins $(pinned scala-cli). Remove the override (mise.local.toml, .tool-versions, MISE_SCALA_CLI_VERSION)."
case $java_version in
*"$java_build "*) ;;
*) fail "This java is not $(pinned java) from mise.toml: $(command -v java). Remove the override (mise.local.toml, .tool-versions, MISE_JAVA_VERSION)." ;;
esac
# Scala CLI takes the JDK from JAVA_HOME, other tools from PATH: both must be the pinned one.
[ "$(command -v java)" = "${JAVA_HOME:-}/bin/java" ] ||
  fail "JAVA_HOME (${JAVA_HOME:-unset}) is not the JDK on PATH ($(command -v java))."

# A version mismatch explains local-vs-CI differences.
printf 'scala-cli %s, %s, Scala %s, scalafmt %s\n' "$scala_cli_version" \
  "$(printf '%s\n' "$java_version" | head -n 1)" "$(sed -n 's,^//> using scala ,,p' project.scala)" \
  "$(sed -n 's/^version *= *//p' .scalafmt.conf)"

# grep exits 1 when nothing matches and 2 when it cannot read a file. Only 1 may pass, or a file
# that grep cannot open would pass every scan below.
scan() {
  status=0
  grep -nE "$@" || status=$?
  [ "$status" -le 1 ] || fail 'grep could not read the files above.'
  [ "$status" -eq 0 ]
}

step 'Sources only in src/ and project.scala'
# Scala CLI compiles only project.scala and src/ (see the last step). A source file anywhere else
# would be skipped by the build and by the checks below, so it fails here instead.
stray=$(find . -path './.*' -prune -o -type f \( -name '*.scala' -o -name '*.sc' -o -name '*.java' \) \
  -print | grep -vE '^\./(project\.scala|src/.*\.scala)$' || true)
if [ -n "$stray" ]; then
  printf '%s\n' "$stray" >&2
  fail 'Move the files above under src/main/scala or src/test/scala as .scala files.'
fi
# Scala CLI follows symlinks, but the scans below read only plain files, so a link could bring in
# an unscanned `//> using` line. The scans split the file list on spaces, so names stay simple.
odd=$(find project.scala src \( ! -type f ! -type d -o -name '*[!A-Za-z0-9_.-]*' \) -print) ||
  fail 'Cannot list project.scala and src/.'
if [ -n "$odd" ]; then
  printf '%s\n' "$odd" >&2
  fail 'Replace the symlinks above with plain files, and use only letters, digits, _ . - in names.'
fi
scala_files=$(find src -type f -name '*.scala')
[ -n "$scala_files" ] || fail 'No .scala files under src/.'

step 'Format rules fixed in .scalafmt.conf'
# scalafmt settings such as project.excludePaths or a lower maxColumn would skip or loosen the
# format check. The settings must be exactly these. Change them here and in .scalafmt.conf together.
expected_fmt='version = 3.11.5
runner.dialect = scala3
maxColumn = 100
rewrite.scala3.convertToNewSyntax = true
rewrite.scala3.removeOptionalBraces = yes
rewrite.rules = [RedundantBraces, RedundantParens, SortModifiers, Imports]
rewrite.imports.sort = ascii
rewrite.imports.groups = [["java\\..*", "javax\\..*"], ["scala\\..*"]]
docstrings.style = Asterisk'
if [ "$(grep -vE '^[[:space:]]*(#|$)' .scalafmt.conf)" != "$expected_fmt" ]; then
  printf 'Expected these settings, besides comments:\n%s\n' "$expected_fmt" >&2
  fail 'Restore .scalafmt.conf.'
fi

step 'Format (scalafmt, rules in .scalafmt.conf). Fix: scripts/format'
# scalafmt runs on the JVM, not as the native binary that `scala-cli fmt` downloads. That binary is
# built with Scala Native, whose runtime corrupts memory now and then (scalameta/scalafmt#5254). On
# CI it segfaulted, or read a formatted file as empty and reported it unformatted; a file read as
# empty can pass unformatted too. The version comes from .scalafmt.conf, fixed by the step above.
# -S is the Scala version scalafmt itself is built with. scripts/format runs the same command.
scala-cli run --server=false -S 2.13.18 \
  --dep "org.scalameta:scalafmt-cli_2.13:$(sed -n 's/^version = //p' .scalafmt.conf)" \
  --main-class org.scalafmt.cli.Cli -- --check --non-interactive --respect-project-filters \
  --config .scalafmt.conf project.scala src

step 'Build settings only in project.scala, in their fixed shapes'
# Scala CLI reads `//> using` lines from every source file, so one line in a source file could
# add -Wconf or a dependency that review misses. Scala CLI also reads a directive after a
# byte-order mark or another character that grep does not count as space, so `//>` is banned
# anywhere in a line.
# shellcheck disable=SC2086 # the step above keeps spaces out of file names
if scan '//>' $scala_files; then
  fail 'Move the lines above to project.scala. Build settings live only there.'
fi
# project.scala holds only comments and these directive shapes. Each dependency or plugin is one
# exact version on its own line: "latest", ranges, toolkits and extra repositories resolve to
# different code over time.
version='[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.]+)?'
coord="[A-Za-z0-9_.-]+:{1,3}[A-Za-z0-9_.-]+:$version"
shapes="^$|^//( .*)?$|^//> using scala $version$|^//> using jvm system$|^//> using options [^ ].*$|^//> using javaOpt [^ ].*$|^//> using (plugin|dep|test\\.dep) $coord$"
if grep -nvE "$shapes" project.scala; then
  fail 'project.scala allows only comments and: scala X.Y.Z, jvm system, options, javaOpt, and one plugin, dep or test.dep with an exact version per line.'
fi
# The compiler options must be exactly this set. Removing one would switch a check off, and adding
# one (such as -Wconf, -nowarn or another -source) could weaken it. To change the set, change
# project.scala and this list together, with the owner's approval.
expected_options='-Werror -Wall -deprecation -feature -language:strictEquality -source:future
-P:wartremover:traverser:org.wartremover.warts.Var
-P:wartremover:traverser:org.wartremover.warts.MutableDataStructures
-P:wartremover:traverser:org.wartremover.warts.Null
-P:wartremover:traverser:org.wartremover.warts.Return
-P:wartremover:traverser:org.wartremover.warts.While
-P:wartremover:traverser:org.wartremover.warts.AsInstanceOf
-P:wartremover:traverser:org.wartremover.warts.IsInstanceOf
-P:wartremover:traverser:org.wartremover.warts.OptionPartial
-P:wartremover:traverser:org.wartremover.warts.TryPartial
-P:wartremover:traverser:org.wartremover.warts.EitherProjectionPartial
-P:wartremover:traverser:org.wartremover.warts.IterableOps
-P:wartremover:traverser:org.wartremover.warts.TripleQuestionMark
-P:wartremover:traverser:org.wartremover.warts.ArrayToString
-P:wartremover:traverser:org.wartremover.warts.StringPlusAny
-P:wartremover:traverser:org.wartremover.warts.PlatformDefault
-P:wartremover:traverser:org.wartremover.warts.Throw
-P:wartremover:traverser:org.wartremover.warts.SeqApply
-P:wartremover:traverser:org.wartremover.warts.SeqUpdated
--sun-misc-unsafe-memory-access=allow'
expected=$(printf '%s\n' "$expected_options" | tr ' ' '\n' | sort)
actual=$(sed -nE 's,^//> using (options|javaOpt) ,,p' project.scala | tr ' ' '\n' | sort)
if [ "$expected" != "$actual" ]; then
  printf 'Options that differ (< expected by scripts/check, > in project.scala):\n' >&2
  diff_in=$(mktemp)
  printf '%s\n' "$expected" >"$diff_in"
  printf '%s\n' "$actual" | diff "$diff_in" - >&2 || true
  rm -f "$diff_in"
  fail 'Restore the compiler options in project.scala.'
fi

step 'No switched-off checks in comments'
# scalafmt reads switches from comments: `format: off`, the IntelliJ form `@formatter:off`, and
# `scalafmt: { ... }`, which changes the rules for one file. Comments never reach the compiled code
# that the search after the build reads, so they are searched here, in any case.
format_off='scalafmt *: *\{|(@?formatter|format) *: *(off|on)'
# shellcheck disable=SC2086 # the step above keeps spaces out of file names
if scan -i "$format_off" .scalafmt.conf $scala_files; then
  fail 'The lines above switch off the format check. Remove them and format the code.'
fi

step 'Build and test (warnings and WartRemover findings are errors, set in project.scala)'
# --server=false: with the Bloop compile server, Scala CLI exits 0 and even runs the tests when
# -Werror turns a warning into an error (VirtusLab/scala-cli#3735). Without it each run compiles
# from scratch, so the result never depends on server state.
# --suppress-outdated-dependency-warning: that hint asks Maven Central, so it changes by the day.
# --require-tests with munit as the only framework: a run that finds no test suite fails.
# -Vprint:typer: the compiler prints the code it compiled, after it resolved every name. The next
# step searches that code instead of the source text, so an alias, a renamed import, a line break
# or a comment-like line in a string cannot hide a switch-off. The printout is kept out of the log
# shown here (hide_trees). -color:never keeps it plain text.
# The logging setting makes the JDK record every call of System.exit with its caller (see the
# last step).
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
test_log=$work/test.log
# shellcheck disable=SC2016 # %5$s and %6$s are Java format fields, not shell variables
printf '%s\n' 'handlers = java.util.logging.FileHandler' \
  "java.util.logging.FileHandler.pattern = $work/exit.log" \
  'java.util.logging.FileHandler.level = ALL' \
  'java.util.logging.FileHandler.formatter = java.util.logging.SimpleFormatter' \
  'java.util.logging.SimpleFormatter.format = %5$s%6$s%n' \
  'java.lang.Runtime.level = ALL' >"$work/logging.properties"
# shellcheck disable=SC2016 # an awk program, not shell code
hide_trees='
  /^\[\[syntax trees at end of/ { hide = 1; next }
  hide == 1 { if ($0 == "}" || $0 == "<empty>") hide = 2; next }
  hide == 2 { hide = 0; if ($0 == "") next }
  { print; fflush() }
'
{
  if scala-cli test project.scala src --server=false --suppress-outdated-dependency-warning \
    --test-framework munit.Framework --require-tests -O -Vprint:typer -O -color:never \
    --java-opt "-Djava.util.logging.config.file=$work/logging.properties" 2>&1; then
    echo 0 >"$work/status"
  else
    echo 1 >"$work/status"
  fi
} | tee "$test_log" | awk "$hide_trees"
test_status=$(cat "$work/status")
# No test ran: the build failed, and its errors are above.
if [ "$test_status" != 0 ] && ! grep -q '^Test run ' "$test_log"; then
  exit 1
fi

step 'No switched-off checks in the compiled code'
# The compiled code from the step above, one file after another, up to the first test result.
# String and char literals are blanked out first, so words in text never count. Each finding is
# printed as "file: reason: code". The compiler adds code of its own, which is skipped:
# `x$1: @unchecked` in a desugared `for`, `@uncheckedVariance` on default arguments, the try and
# catch in enum and @main code.
# Universal equality: a CanEqual instance for a top type (Any, AnyRef, AnyVal, Matchable, Object),
# for a type alias or a type parameter that can stand for one, or a generic CanEqual given.
# Test files are the files Scala CLI puts in the test scope (a folder named test, or a name that
# ends in .test.scala) and every file that uses munit or ScalaCheck. Only there are the munit and
# ScalaCheck words banned, so a domain name such as `def property` or `withTags` in main code
# passes. Test files also may not catch exceptions: a test that catches can catch its own failed
# assertion. The same goes for a recovered Future, an intercept of a type that munit's failures
# belong to (AssertionError and its supertypes, also through an alias or a type parameter), and a
# custom munit.Compare, which decides what assertEquals accepts.
# Every package is {{namespace}} or below it. A class in another package, such as
# scala.build.testrunner.DynamicTestRunner, would stand in for the library class of that name.
# shellcheck disable=SC2016 # an awk program, not shell code
tree_scan='
  function strip(s,   out, i, n, c, j) {
    out = ""; n = length(s); i = 1
    while (i <= n) {
      c = substr(s, i, 1)
      if (c == "\"") {
        for (i++; i <= n; i++) { c = substr(s, i, 1); if (c == "\\") i++; else if (c == "\"") break }
        out = out "\"\""; i++; continue
      }
      if (c == q && substr(s, i + 1, 1) == "\\") {
        j = index(substr(s, i + 3), q)
        if (j > 0) { out = out q q; i += 3 + j; continue }
      }
      if (c == q && substr(s, i + 2, 1) == q) { out = out q q; i += 3; continue }
      out = out c; i++
    }
    return out
  }
  function rel(p) {
    if (index(p, root "/") == 1) return substr(p, length(root) + 2)
    if (index(p, real "/") == 1) return substr(p, length(real) + 2)
    return p
  }
  function keep() {
    if (pending == "") return
    n++; L[n] = pending; F[n] = file; J[file] = J[file] " " pending; pending = ""
  }
  function opens(s,   t, o) { t = s; o = gsub(/\{/, "", t); t = s; return o - gsub(/\}/, "", t) }
  function report(f, why, s) {
    gsub(/^ +| +$/, "", s)
    if (length(s) > 150) s = substr(s, 1, 147) "..."
    printf "%s: %s: %s\n", f, why, s
  }
  function mentions(s,   part, k, m) {
    m = split(s, part, /[^A-Za-z0-9_$]+/)
    for (k = 1; k <= m; k++) if (part[k] in top || part[k] in wide) return 1
    return 0
  }
  function collect(s,   rest, name, body, m, hi) {
    rest = s
    while (match(rest, / type [A-Za-z_][A-Za-z0-9_]*/)) {
      name = substr(rest, RSTART + 6, RLENGTH - 6); rest = substr(rest, RSTART + RLENGTH); body = rest
      if (match(body, / (final|lazy|given|def|val|var|type|class|object|trait|case|private|protected|override|implicit|sealed|abstract|opaque|enum|import|export|package|module|inline|transparent)[ [(]|[{}]/))
        body = substr(body, 1, RSTART - 1)
      alias[name] = alias[name] " " body
    }
    rest = s
    while (match(rest, /[[, ][A-Za-z_][A-Za-z0-9_]*( >: [^],<]*)? <: [A-Za-z0-9_.]+/)) {
      m = substr(rest, RSTART + 1, RLENGTH - 1); rest = substr(rest, RSTART + RLENGTH)
      name = m; sub(/ .*/, "", name); hi = m; sub(/.* <: /, "", hi); sub(/.*\./, "", hi)
      if (hi in top) wide[name] = 1
      if (hi in failtop) catcher[name] = 1
    }
  }
  function catches(s,   part, k, m) {
    m = split(s, part, /[^A-Za-z0-9_$]+/)
    for (k = 1; k <= m; k++) if (part[k] in failtop || part[k] in catcher) return 1
    return 0
  }
  function widecatch(s,   rest, d, k, len, c, args) {
    rest = s
    while (match(rest, /intercept(Message)?\[/)) {
      rest = substr(rest, RSTART + RLENGTH); len = length(rest); d = 1
      for (k = 1; k <= len && d > 0; k++) { c = substr(rest, k, 1); if (c == "[") d++; else if (c == "]") d-- }
      args = substr(rest, 1, k - 2)
      if (catches(args)) return args
      rest = substr(rest, k)
    }
    return ""
  }
  function caneq(f, s,   rest, i, d, k, len, c, args) {
    rest = s
    while ((i = index(rest, "CanEqual[")) > 0) {
      rest = substr(rest, i + 9); len = length(rest); d = 1
      for (k = 1; k <= len && d > 0; k++) { c = substr(rest, k, 1); if (c == "[") d++; else if (c == "]") d-- }
      args = substr(rest, 1, k - 2)
      if (mentions(args)) report(f, "universal equality", "CanEqual[" args "]")
      rest = substr(rest, k)
    }
  }
  function check(i,   f, s, t, p, u, w) {
    f = F[i]; s = L[i]; t = (f in testfile)
    gsub(/x\$[0-9]+:\(x\$[0-9]+ : .*\) @unchecked/, "", s)
    if (s ~ /^ *def [A-Za-z0-9_]*[$]default[$][0-9]+/) gsub(/@uncheckedVariance/, "", s)
    if (s ~ ("@([A-Za-z0-9_]+[.])*(nowarn|unused|unchecked|uncheckedVariance|uncheckedStable|uncheckedCaptures|SuppressWarnings)" e))
      report(f, "an annotation that silences a check", s)
    if (s ~ (b "runtimeChecked" e)) report(f, "runtimeChecked skips the match check", s)
    if (s ~ ("^ *(import|export) .*" b "language" e) || s ~ ("scala[.]language" e) || s ~ /language[.]type/)
      report(f, "a language import switches a feature warning off", s)
    if (s ~ /canEqualAny/) report(f, "universal equality", s)
    if (s ~ ("(^|[^.A-Za-z0-9_$])(require|assert)[(]") || s ~ /Predef[.](require|assert)[(]/ || s ~ (b "sys[.]error[(]"))
      report(f, "throws without the throw keyword: return an Either", s)
    if (s ~ /Predef[.]assume[(]/) report(f, "assume skips a test or a check", s)
    if (s ~ /^ *package [^ ]+ [{]/) {
      p = s; sub(/^ *package /, "", p); sub(/ .*/, "", p)
      if (p != ns && index(p, ns ".") != 1 && p != "<empty>")
        report(f, "a package outside " ns ": its classes can stand in for a library or the test runner", s)
    }
    if (s ~ /scala[.]build[.]/) report(f, "the test runner: code must not call or replace it", s)
    if (s ~ /scala[.]quoted[.]/) report(f, "a macro: WartRemover never sees the code it builds", s)
    if (s ~ ("munit[.](Tag|Ignore|Only|Flaky|Fail|Pending|Slow)" e) || s ~ (b "package munit" e))
      report(f, "a munit tag skips, focuses or excuses tests", s)
    if (!t) return
    if (s ~ (b "(IgnoreSuite|munitIgnore|munitFlakyOK|withTags|scalaCheckTestParameters|withMinSuccessfulTests|isCI)" e) ||
      s ~ (b "(munitTests|munit[A-Za-z]*Transforms?|(Test|Suite|Value)Transforms?)" e) ||
      s ~ ("org[.]scalacheck[.]Properties" e))
      report(f, "changes which tests run or how often", s)
    if (s ~ (b "assume[(]")) report(f, "assume skips a test or a check", s)
    if (s ~ ("[.](only|ignore|pending|flaky|fail|tag)" e)) report(f, "a munit test option skips, focuses or excuses a test", s)
    if (s ~ (b "def (test|property)" e)) report(f, "replaces how munit registers tests", s)
    if ((s ~ (b "catch" e) && s !~ /[$]values[.]apply[(]ordinal[)] catch/ && L[i + 2] !~ /CommandLineParser[.]ParseError/) ||
      s ~ ("scala[.]util[.](Try|Using|Using[.]Manager)[.]apply" e) || s ~ /scala[.]util[.]control[.]Exception/)
      report(f, "a test that catches exceptions can catch its own failure: use intercept", s)
    u = s; gsub(/Future[.]failed[[(]/, "", u)
    if (u ~ ("[.](recover|recoverWith|fallbackTo|transform|transformWith|failed|exceptionally)" e))
      report(f, "a test that recovers a failed Future can hide its own failure", s)
    if (s ~ /munit[.]Compare[[]/) report(f, "a custom munit.Compare can make assertEquals accept anything", s)
    if ((w = widecatch(s)) != "")
      report(f, "intercept[" w "] also catches the failures of munit assertions: intercept the exception you expect", s)
  }
  BEGIN { q = sprintf("%c", 39); b = "(^|[^A-Za-z0-9_])"; e = "([^A-Za-z0-9_]|$)" }
  { gsub(/\033\[[0-9;]*m/, "") }
  /^Test run / { stop = 1 }
  stop { next }
  /^\[\[syntax trees at end of/ {
    keep(); file = $0; sub(/^.*\]\] *\/\/ */, "", file); file = rel(file); seen[file] = 1; next
  }
  file == "" { next }
  {
    line = strip($0)
    if (pending != "") { sub(/^ +/, "", line); line = pending (pending ~ /[.]$/ ? "" : " ") line; pending = "" }
    pending = line
    if (line ~ /[.]$/ || (line ~ /^ *(import|export) / && opens(line) > 0)) next
    keep()
  }
  END {
    keep()
    split("Any AnyRef AnyVal Matchable Object", word, " ")
    for (k in word) top[word[k]] = 1
    # munit failures are AssertionErrors, so intercept with one of these types catches them.
    split("Throwable Error AssertionError FailException FailExceptionLike ComparisonFailException FailSuiteException ComparisonFailure AssertionFailedError", word, " ")
    for (k in word) failtop[word[k]] = 1
    m = split(expected, want, " ")
    for (k = 1; k <= m; k++) if (want[k] != "" && !(want[k] in seen)) { print want[k] ": not in the compiled code"; missing = 1 }
    if (missing) exit 3
    for (f in J) {
      collect(J[f])
      if (f ~ /(^|\/)test\// || f ~ /\.test\.scala$/ || J[f] ~ /munit[.]|org[.]scalacheck[.]/) testfile[f] = 1
    }
    for (a in alias) if (mentions(alias[a])) wide[a] = 1
    for (round = 0; round < 20; round++) {
      changed = 0
      for (a in alias) if (!(a in wide) && mentions(alias[a])) { wide[a] = 1; changed = 1 }
      if (!changed) break
    }
    for (round = 0; round < 20; round++) {
      changed = 0
      for (a in alias) if (!(a in catcher) && catches(alias[a])) { catcher[a] = 1; changed = 1 }
      if (!changed) break
    }
    for (f in J) caneq(f, J[f])
    for (k = 1; k <= n; k++) check(k)
  }
'
# Every source file must be in the printout, or a file would escape the search.
# shellcheck disable=SC2086 # the step above keeps spaces out of file names
expected=$(printf '%s ' project.scala $scala_files)
status=0
findings=$(awk -v root="$PWD" -v real="$root" -v ns='{{namespace}}' -v expected="$expected" "$tree_scan" "$test_log") ||
  status=$?
if [ "$status" -ne 0 ]; then
  printf '%s\n' "$findings" >&2
  fail 'The compiled code above is missing, so the search could not run. Run scripts/check again.'
fi
if [ -n "$findings" ]; then
  printf '%s\n' "$findings" >&2
  fail 'The code above switches off a check. Remove it and fix the cause.'
fi

step 'Build and test: test results'
[ "$test_status" = 0 ] || fail 'The build or a test failed. The errors are in the output of the build and test step.'
# A test that ends the JVM with exit code 0 stops the run early, and the suites after it never
# report. The test runner itself exits last, so the last recorded exit must come from it, with
# status 0. The status matters too: a shutdown hook can turn the runner's exit(1) into a
# Runtime.halt(0), which records nothing, so the scala-cli status alone would read as a pass.
exit_record=''
if [ -f "$work/exit.log" ]; then
  exit_record=$(awk '
    /^java[.]lang[.]Throwable: Runtime[.]exit[(]/ {
      code = $0; sub(/^.*Runtime[.]exit[(]/, "", code); sub(/[)].*$/, "", code); caller = ""; seen = 1; next
    }
    seen && caller == "" && /^[ \t]*at / && !/at java[.]base\// && !/at scala[.]sys[.]package[$][.]exit/ { caller = $0 }
    END { sub(/^[ \t]*at /, "", caller); if (seen) print "exit(" code ") from " caller }
  ' "$work/exit.log")
fi
case $exit_record in
'exit(0) from scala.build.testrunner.DynamicTestRunner$.main('*) ;;
*) fail "The test run did not end with the test runner's exit(0). Last recorded exit: ${exit_record:-none (Runtime.halt?)}. Tests must not end the JVM." ;;
esac
# Each suite ends with "Test run <suite> finished: F failed, I ignored, T total". A failed test, a
# skipped test, or a suite with no tests (munit counts it as ignored) fails here, whatever the exit
# status. munit prints "==> s <test> skipped" for a test that skips itself, also when the summary
# says 0 ignored. A suite that started and did not finish fails, and so does an exception that
# ended another thread: an assertion there never reaches munit.
esc=$(printf '\033')
skipped=$(sed "s/$esc\\[[0-9;]*m//g" "$test_log" | awk '
  /^Test run .* started/ { started++ }
  /^Test run .* finished: / { runs++; if ($0 !~ / 0 failed, / || $0 !~ / 0 ignored, / || $0 ~ / 0 total/) print }
  /^==> s / { print "Skipped:" substr($0, 6) }
  /^Exception in thread / { print }
  END {
    if (runs == 0) print "No test summary found."
    if (started != runs) print started " suites started, " runs " finished."
  }
')
if [ -n "$skipped" ]; then
  printf '%s\n' "$skipped" >&2
  fail 'Every suite must pass, run at least one test, and skip or ignore none. No test may throw in another thread.'
fi

printf '\nAll checks passed.\n'
