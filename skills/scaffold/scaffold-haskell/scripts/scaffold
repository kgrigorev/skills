#!/bin/sh
# Renders the Haskell project template into a folder.
# Usage: scaffold <target-dir> <package> <synopsis> <reader>
#   package:  a cabal package name, lower case, words joined by "-", for example "my-tool".
#   synopsis: one line for the .cabal file, for example "A tool that renames photos".
#   reader:   who reads the code, completing "The reader is ...", for example
#             "a Go developer new to Haskell". AGENTS.md and CODING_STANDARDS.md use it.
#
# Needs mise, git, and GHC from ghcup (see ghc_version below). The script installs the tools that
# mise.toml pins, runs `cabal update`, renders the template, formats the Haskell and cabal files,
# writes cabal.project.freeze, runs `git init` when needed and points git at the project's hooks.
# It never overwrites a file and does not commit.
set -eu
# shellcheck source=scaffold-lib.sh
. "$(dirname "$0")/scaffold-lib.sh"

if [ "$#" -ne 4 ]; then
  echo 'Usage: scaffold <target-dir> <package> <synopsis> <reader>' >&2
  exit 2
fi
target=$1
package=$2
synopsis=$3
reader=$4
template=$(cd "$(dirname "$0")/../template" && pwd)

# The GHC version of new projects. Pick the newest release that ghcup lists and HLS supports.
ghc_version=9.14.1

check_inputs "$package" "$synopsis" "$reader"
require_hidden "$template"
require_tools mise git

# my-tool -> MyTool
module=$(printf '%s' "$package" | awk -F- '{
  for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2)
}')

# --- Toolchain ----------------------------------------------------------------------------------

# The project accepts only ghcup's GHC: another build of the same version has another ABI.
# Installing GHC takes 1 to 2 GB, so the user decides when it happens.
ghcup_bin="${GHCUP_INSTALL_BASE_PREFIX:-$HOME}/.ghcup/bin"
ghcup_version=$(sed -n 's/^ghcup = "\(.*\)"$/\1/p' "$template/mise.toml.tmpl")
[ -x "$ghcup_bin/ghc-$ghc_version" ] && [ -x "$ghcup_bin/ghc-pkg-$ghc_version" ] ||
  fail "GHC $ghc_version from ghcup is not in $ghcup_bin. Install it (1 to 2 GB):
  mise exec ghcup@$ghcup_version -- ghcup install ghc $ghc_version"

# Run the pinned tools before the project exists: from a temporary copy of mise.toml and
# mise.lock, trusted for this run only.
tools=$(mktemp -d "${TMPDIR:-/tmp}/scaffold-tools.XXXXXX") || fail 'cannot create a temporary folder'
trap 'rm -f "$scaffold_sed"; rm -rf "$tools"' EXIT
cp "$template/mise.toml.tmpl" "$tools/mise.toml"
cp "$template/mise.lock.tmpl" "$tools/mise.lock"
MISE_TRUSTED_CONFIG_PATHS="$tools${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
# The user's global mise config stays out, as in scripts/check: its tools and [env] would apply
# here too, and mise would install them.
MISE_GLOBAL_CONFIG_FILE=/dev/null/no-global-config.toml
export MISE_TRUSTED_CONFIG_PATHS MISE_GLOBAL_CONFIG_FILE
pinned() { (cd "$tools" && mise exec -- "$@"); }
(cd "$tools" && mise install --quiet) || fail 'mise could not install the pinned tools.'

# index-state is today, so the local index must be at least that new.
pinned cabal update || fail 'cabal update failed. It needs the network.'

major_minor() { printf '%s' "$1" | cut -d. -f1-2; }
# The newest version of a package in the local index.
latest() {
  pinned cabal list --simple-output "$1" 2>/dev/null | awk -v p="$1" '$1 == p { v = $2 } END { print v }'
}

base_bound=$(major_minor "$("$ghcup_bin/ghc-pkg-$ghc_version" field base version --simple-output)")
text_bound=$(major_minor "$("$ghcup_bin/ghc-pkg-$ghc_version" field text version --simple-output)")
hspec_latest=$(latest hspec)
quickcheck_latest=$(latest QuickCheck)
[ -n "$hspec_latest" ] && [ -n "$quickcheck_latest" ] ||
  fail 'cannot find hspec or QuickCheck in the cabal index.'
hspec_bound=$(major_minor "$hspec_latest")
quickcheck_bound=$(major_minor "$quickcheck_latest")
index_state=$(date -u +%Y-%m-%dT00:00:00Z)

# --- Render -------------------------------------------------------------------------------------

set_var package "$package"
set_var module "$module"
set_var synopsis "$synopsis"
set_var reader "$reader"
set_var ghc_version "$ghc_version"
set_var base_bound "$base_bound"
set_var text_bound "$text_bound"
set_var hspec_bound "$hspec_bound"
set_var quickcheck_bound "$quickcheck_bound"
set_var index_state "$index_state"

render_template "$template" "$target"
cd "$target"
finish_project
# Trust this project's mise.toml, so scripts/check and the git hook can run its tools.
mise trust --quiet "$PWD/mise.toml"

# cabal-gild sorts build-depends and Ormolu sorts imports. The order depends on the names.
mise exec -- cabal-gild "$package.cabal"
# shellcheck disable=SC2046 # file names have no spaces
mise exec -- ormolu --mode inplace $(find app src test -name '*.hs')
# Lock the dependency versions. scripts/check compares against this file.
mise exec -- cabal freeze -v0 || fail 'cabal freeze failed: the dependency bounds do not solve.'

printf 'Created %s (module %s) in %s\n' "$package" "$module" "$(pwd)"
printf 'ghc %s (ghcup), %s\n' "$ghc_version" \
  "$(sed -n 's/^\([a-z":/-]*\) = .*"\([0-9.]*\)".*/\1 \2/p' mise.toml | tr -d '"' | paste -sd, - | sed 's/,/, /g')"
printf 'base ^>=%s, text ^>=%s, hspec ^>=%s, QuickCheck ^>=%s, index-state %s\n' \
  "$base_bound" "$text_bound" "$hspec_bound" "$quickcheck_bound" "$index_state"
list_files
echo cabal.project.freeze
