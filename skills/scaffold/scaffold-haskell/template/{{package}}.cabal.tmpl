cabal-version: 3.12
name: {{package}}
version: 0.1.0.0
synopsis: {{synopsis}}
build-type: Simple
tested-with: ghc =={{ghc_version}}
extra-doc-files: README.md

-- Settings shared by every component. Agents: change them only with the owner's approval.
-- cabal-gild formats this file: run scripts/format after editing it.
common common
  default-language: GHC2024
  -- GHC2024 turns on some type-level features. Keep the code plain: switch them off.
  default-extensions:
    NoDataKinds
    NoExistentialQuantification
    NoGADTs
    NoPolyKinds
    NoRankNTypes
    NoTypeOperators
    OverloadedStrings

  build-depends: base ^>={{base_bound}}
  -- Warnings worth fixing. cabal.project turns every warning into an error.
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wmissing-import-lists
    -Wpartial-fields
    -Wprepositive-qualified-module
    -Wredundant-constraints
    -Wunused-packages
    -haddock
    -Winvalid-haddock

library
  import: common
  hs-source-dirs: src
  exposed-modules: {{module}}
  build-depends: text ^>={{text_bound}}

executable {{package}}
  import: common
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    text ^>={{text_bound}},
    {{package}},

test-suite {{package}}-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: {{module}}Spec
  build-depends:
    QuickCheck ^>={{quickcheck_bound}},
    hspec ^>={{hspec_bound}},
    text ^>={{text_bound}},
    {{package}},

  build-tool-depends: hspec-discover:hspec-discover ^>={{hspec_bound}}
