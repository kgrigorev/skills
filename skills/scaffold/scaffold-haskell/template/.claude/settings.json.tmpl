{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.cache/cabal",
        "~/.local/state/cabal",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.cache/mise"
      ]
    },
    "excludedCommands": ["gh *"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-on-stop.sh\"",
            "timeout": 600,
            "statusMessage": "Running scripts/check"
          }
        ]
      }
    ]
  }
}
