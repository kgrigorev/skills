#!/bin/sh
# Lands a stack of PRs on main with squash merges, bottom first, without a force-push.
# Usage: land-squash-stack [--dry-run] [--after <landed pr>] <pr> [<pr>...]   (lowest PR first)
#   --dry-run  prints the plan and checks the stack's shape; changes nothing
#   --after    continue a stopped run: <landed pr> was squashed already, so start by bringing
#              main into the first <pr>'s branch
#
# After each squash, main's files equal the merged PR's head. The next branch already holds that
# head, so it takes main with a `-s ours` merge: the merge changes no file, and the PR's diff
# against main shrinks to its own commits. Both conditions are checked before each such merge;
# the script stops when either fails, and before each squash when CI is red or unfinished.
set -eu

dry='' after=''
while :; do
  case ${1:-} in
  --dry-run) dry=1; shift ;;
  --after) after=$2; shift 2 ;;
  *) break ;;
  esac
done
[ "$#" -ge 1 ] || { sed -n '3p' "$0" >&2; exit 2; }

die() { echo "STOP: $*" >&2; exit 1; }
field() { gh pr view "$1" --json "$2" --jq ".$2"; }

[ "$(gh repo view --json squashMergeAllowed --jq .squashMergeAllowed)" = true ] ||
  die 'This repo does not allow squash merges. Follow STACKS.md for merge commits instead.'

work=$(mktemp -d "${TMPDIR:-/tmp}/land-squash-stack.XXXXXX")
trap 'git worktree remove --force "$work/next" 2>/dev/null || true; rm -rf "$work"' EXIT

# Waits until the PR is based on main at the expected head, GitHub would merge it, and no check
# is pending or failing, required or not.
wait_ready() {
  pr=$1 want=$2 i=0
  while :; do
    info=$(gh pr view "$pr" --json baseRefName,headRefOid,mergeable,mergeStateStatus \
      --jq '"\(.baseRefName) \(.headRefOid) \(.mergeable) \(.mergeStateStatus)"')
    case $info in
    *" CONFLICTING "* | *" DIRTY") die "#$pr has conflicts with main: $info" ;;
    "main $want MERGEABLE "*)
      buckets=$(gh pr checks "$pr" --json bucket --jq '.[].bucket' 2>/dev/null || true)
      case $buckets in
      *fail* | *cancel*) gh pr checks "$pr" >&2 || true; die "#$pr has failing checks." ;;
      *pending*) ;;
      *) case $info in *" CLEAN" | *" HAS_HOOKS" | *" UNSTABLE") return 0 ;; esac ;;
      esac
      ;;
    esac
    i=$((i + 1))
    [ "$i" -le 120 ] || die "#$pr was not ready after 60 minutes: $info"
    sleep 30
  done
}

# The commit below any merges that changed no file, such as the `-s ours` merges this script
# makes: the branch above was built on that commit, not on the merges.
before_main_merges() {
  c=$1
  while p=$(git rev-parse -q --verify "$c^2" >/dev/null && git rev-parse "$c^1") &&
    git diff --quiet "$p" "$c"; do
    c=$p
  done
  printf '%s\n' "$c"
}

# Brings main into the next PR's branch after the PR below it landed. Usage: merge_up <landed
# head> <landed pr> <next pr>
merge_up() {
  landed=$1 landed_pr=$2 next=$3
  next_branch=$(field "$next" headRefName)
  next_head=$(field "$next" headRefOid)
  git fetch -q origin
  git merge-base --is-ancestor "$(before_main_merges "$landed")" "$next_head" ||
    die "#$next ($next_branch) does not hold #$landed_pr's head $landed, so landing it would undo #$landed_pr's newer commits. Merge $landed into $next_branch, push, and run again with --after $landed_pr."
  if [ -n "$dry" ]; then
    echo "would point #$next at main, delete #$landed_pr's branch, merge main into $next_branch with -s ours, and wait for its checks"
    return 0
  fi
  git diff --quiet origin/main "$landed" ||
    die "main's files differ from #$landed_pr's head (main moved, or the squash changed them). Merge main into $next_branch normally, resolve, push, and run again from #$next."
  # Point the next PR at main before its old base goes, or deleting that branch closes it.
  [ "$(field "$next" baseRefName)" = main ] || gh pr edit "$next" --base main >/dev/null
  old_branch=$(field "$landed_pr" headRefName)
  git push -q origin --delete "$old_branch" 2>/dev/null || true
  git worktree add -q --detach "$work/next" "$next_head"
  git -C "$work/next" merge -q -s ours --no-edit -m "Merge main into $next_branch after #$landed_pr landed" origin/main
  git -C "$work/next" push -q origin "HEAD:refs/heads/$next_branch"
  new=$(git -C "$work/next" rev-parse HEAD)
  git worktree remove --force "$work/next"
  echo "#$next now holds main ($(git rev-parse --short "$new")); waiting for its checks"
  wait_ready "$next" "$new"
}

prev_head='' prev_pr=''
if [ -n "$after" ]; then
  [ "$(field "$after" state)" = MERGED ] || die "#$after is not merged."
  prev_head=$(field "$after" headRefOid) prev_pr=$after
fi

for pr in "$@"; do
  [ -z "$prev_pr" ] || merge_up "$prev_head" "$prev_pr" "$pr"
  git fetch -q origin
  head=$(field "$pr" headRefOid)
  if [ -z "$dry" ] || [ -z "$prev_pr" ]; then
    [ "$(field "$pr" baseRefName)" = main ] || die "#$pr targets $(field "$pr" baseRefName), not main. Land the PRs below it first."
    git merge-base --is-ancestor origin/main "$head" ||
      die "#$pr does not contain main. Merge main into its branch first, then run again from #$pr."
  fi
  if [ -n "$dry" ]; then
    echo "would wait for #$pr's checks, then squash it as \"$(field "$pr" title) (#$pr)\""
  else
    wait_ready "$pr" "$head"
    git fetch -q origin
    git merge-base --is-ancestor origin/main "$head" ||
      die "main moved while #$pr waited. Merge main into its branch, then run again from #$pr."
    gh pr view "$pr" --json body --jq .body >"$work/body"
    gh pr merge "$pr" --squash --match-head-commit "$head" \
      --subject "$(field "$pr" title) (#$pr)" --body-file "$work/body"
    git fetch -q origin
    echo "#$pr landed as $(git rev-parse --short origin/main)"
  fi
  prev_head=$head prev_pr=$pr
done
if [ -n "$dry" ]; then echo 'Dry run: the plan above changes nothing.'; else echo 'Done: every PR landed.'; fi
