#!/bin/sh
# Lands a stack of PRs with squash merges, bottom first, without a force-push.
# Usage: land-squash-stack [--dry-run] [--admin-if-unstarted] [--after <landed pr>] <pr> [<pr>...]   (lowest PR first)
#   --dry-run  checks the stack and prints the plan; changes nothing
#   --admin-if-unstarted
#              when every failing check of a PR never started (no CI minutes, for example),
#              squash it with `gh pr merge --admin`; a real failure still stops
#   --after    continue a stopped run: <landed pr> was squashed already, so start by bringing
#              the default branch into the first <pr>'s branch
# Run it from a clone whose `origin` is the repo gh resolves, with every PR branch on it. It
# refuses a merge queue and a pull request GitHub has linked into a stack, printing the
# `gh stack merge` command. Every stop after the checks prints the command that continues the run.
#
# After each squash, the default branch's files equal the merged PR's head. The next branch already
# holds that head, so it takes the default branch with a `-s ours` merge: the merge changes no
# file, and the PR's diff shrinks to its own commits. GitHub can report the old head for a while
# after that push, so the script waits until it reports the pushed one. Before anything lands, the
# script checks that each PR is open, not a draft, based on the branch of the PR listed below it,
# and holds that PR's head. Each squash waits until GitHub reports the PR mergeable and no reported check is
# pending or failing. A failing check prints each failing check run's annotation. When every failing
# run has annotations and all of them say the job was not started, the script stops and says the
# checks never started. With --admin-if-unstarted it squashes that PR with --admin instead, once two
# reads $poll seconds apart show the same checks, unless a failing commit status or a required review
# would be skipped too. With the flag it first stops when the default branch has a rule that --admin
# would skip and the script does not check.
set -eu

usage() { sed -n '3p' "$0" >&2; exit 2; }
dry='' admin='' after='' prs=''
while [ "$#" -gt 0 ]; do
  case $1 in
  --dry-run) dry=1 ;;
  --admin-if-unstarted) admin=1 ;;
  --after)
    [ "$#" -ge 2 ] || usage
    case $2 in '' | *[!0-9]*) usage ;; esac
    after=$2
    shift
    ;;
  '' | *[!0-9]*) usage ;;
  *) prs="$prs $1" ;;
  esac
  shift
done
[ -n "$prs" ] || usage

poll=${LAND_SQUASH_STACK_POLL:-30} # seconds between checks of a PR; 120 checks at most
last=$after                         # the last PR that landed
todo=$prs                           # the PRs that have not landed, each after a space
resume_after=1                      # the run continues with --after $last

work=$(mktemp -d "${TMPDIR:-/tmp}/land-squash-stack.XXXXXX")
on_exit() {
  code=$?
  git worktree remove --force "$work/next" 2>/dev/null || true
  rm -rf "$work"
  if [ "$code" -ne 0 ] && [ -z "$dry" ] && [ -n "$todo" ]; then
    if [ -n "$resume_after" ] && [ -n "$last" ]; then from="--after $last$todo"; else from=${todo# }; fi
    echo "To continue: sh $0 ${admin:+--admin-if-unstarted }$from" >&2
  fi
}
trap on_exit EXIT
trap 'exit 130' HUP INT TERM

die() { echo "STOP: $*" >&2; exit 1; }
field() { gh pr view "$1" --json "$2" --jq ".$2"; }
fetch_pr() { git fetch -q origin "refs/pull/$1/head"; } # GitHub keeps it after the branch goes
same_tree() { [ "$(git rev-parse "$1^{tree}")" = "$(git rev-parse "$2^{tree}")" ]; }

# The commit below any merges that changed no file, such as the `-s ours` merges this script
# makes: the branch above was built on that commit, not on the merges.
below_merges() {
  bm=$1
  while git rev-parse -q --verify "$bm^2" >/dev/null && same_tree "$bm^1" "$bm"; do
    bm=$(git rev-parse "$bm^1")
  done
  printf '%s\n' "$bm"
}
holds() { git merge-base --is-ancestor "$(below_merges "$1")" "$2"; } # <lower head> <upper head>

# Merges <commit> into <branch> at <head> with `-s ours` and pushes it. Sets $merged to the new head.
merge_ours() { # <branch> <head> <commit> <message>
  git worktree add -q --detach "$work/next" "$2"
  git -C "$work/next" merge -q -s ours --no-edit -m "$4" "$3"
  git -C "$work/next" push -q origin "HEAD:refs/heads/$1"
  merged=$(git -C "$work/next" rev-parse HEAD)
  git worktree remove --force "$work/next"
}

trunk=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
[ "$(gh repo view --json squashMergeAllowed --jq .squashMergeAllowed)" = true ] ||
  die 'This repo does not allow squash merges. Follow GITHUB.md for merge commits instead.'
# shellcheck disable=SC2016 # GraphQL variables, not shell
mq_query='query($owner:String!,$name:String!,$branch:String!){repository(owner:$owner,name:$name){mergeQueue(branch:$branch){id}}}'
[ "$(gh api graphql -F owner='{owner}' -F name='{repo}' -F branch="$trunk" -f query="$mq_query" --jq '.data.repository.mergeQueue != null')" = false ] ||
  die "$trunk has a merge queue, which this script does not drive. Follow GITHUB.md for a merge queue."
squash_msg=$(gh api 'repos/{owner}/{repo}' --jq .squash_merge_commit_message)

# --admin skips every rule on the default branch that a PR does not meet, not only the checks that
# never started. The script checks failing checks and reviews itself, and a squash by GitHub
# always meets the creation, deletion, force-push, linear-history and signed-commit rules. With
# the flag, any other ruleset rule or branch protection setting that is on stops the run before
# anything lands. Each jq program prints the name of every such rule.
# shellcheck disable=SC2016 # jq programs, not shell
rules_jq='def one_of($l): . as $x | any($l[]; . == $x);
  def off: . == null or . == false or . == 0 or . == "" or . == [] or . == {};
  .[] | if .type == "pull_request" then
      (.parameters // {}) | to_entries[]
      | if .key == "allowed_merge_methods" then (if any(.value[]; . == "squash") then empty else "pull_request.\(.key)" end)
        elif .key | one_of(["required_approving_review_count", "require_code_owner_review", "required_reviewers",
          "require_last_push_approval", "require_extra_approval_for_unattributed_changes",
          "dismiss_stale_reviews_on_push", "dismissal_restriction"]) then empty
        elif .value | off then empty
        else "pull_request.\(.key)" end
    elif .type | one_of(["required_status_checks", "creation", "deletion", "non_fast_forward",
      "required_linear_history", "required_signatures"]) then empty
    else .type end'
# shellcheck disable=SC2016 # jq programs, not shell
protection_jq='def one_of($l): . as $x | any($l[]; . == $x);
  def off: . == null or . == false or (type == "object" and .enabled == false);
  to_entries[] | select(.key | one_of(["url", "name", "protection_url", "enabled", "required_status_checks",
      "required_pull_request_reviews", "enforce_admins", "allow_force_pushes", "allow_deletions",
      "block_creations", "required_linear_history", "required_signatures", "allow_fork_syncing"]) | not)
  | select(.value | off | not) | .key'
if [ -n "$admin" ]; then
  gh api "repos/{owner}/{repo}/rules/branches/$trunk?per_page=100" --paginate --jq "$rules_jq" \
    >"$work/rules" 2>"$work/rules.err" || {
    cat "$work/rules.err" >&2
    die "Could not read the rules on $trunk, so the script cannot tell what --admin would skip."
  }
  if gh api "repos/{owner}/{repo}/branches/$trunk/protection" --jq "$protection_jq" \
    >"$work/protection" 2>"$work/protection.err"; then
    cat "$work/protection" >>"$work/rules"
  elif ! grep -qF 'Branch not protected (HTTP 404)' "$work/protection.err"; then
    cat "$work/protection.err" >&2
    die "Could not read $trunk's branch protection, so the script cannot tell what --admin would skip."
  fi
  [ ! -s "$work/rules" ] ||
    die "--admin would also skip these rules on $trunk, which this script does not check: $(tr '\n' ' ' <"$work/rules" | sed 's/ *$//'). Run without --admin-if-unstarted, and see GITHUB.md for checks that never start."
fi

# shellcheck disable=SC2016 # GraphQL variables, not shell
stack_query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){stack{number}}}}'
first=${prs# }
first=${first%% *}
# A `stack` field that GitHub does not have means the PR is not linked. Any other error stops.
if ! sn=$(gh api graphql -F owner='{owner}' -F name='{repo}' -F number="$first" -f query="$stack_query" \
  --jq '.data.repository.pullRequest.stack.number // empty' 2>"$work/stack.err"); then
  if grep -q "Field 'stack' doesn't exist" "$work/stack.err"; then
    sn=''
  else
    cat "$work/stack.err" >&2
    die "Could not read whether #$first is in a GitHub stack."
  fi
fi
[ -z "$sn" ] || die "#$first is in GitHub stack $sn. A linked stack merges with: gh stack merge $sn --yes --squash. When its checks never start, unlink it with gh stack unstack $sn, then run this script with --admin-if-unstarted."

# Checks the whole stack before anything changes.
git fetch -q origin
prev_pr=$after prev_branch='' prev_head=''
if [ -n "$after" ]; then
  [ "$(field "$after" state)" = MERGED ] || die "#$after is not merged."
  fetch_pr "$after"
  prev_branch=$(field "$after" headRefName) prev_head=$(field "$after" headRefOid)
fi
for n in $prs; do
  info=$(gh pr view "$n" --json state,isDraft,baseRefName,headRefName,headRefOid \
    --jq '"\(.state) \(.isDraft) \(.baseRefName) \(.headRefName) \(.headRefOid)"')
  read -r st draft base branch head <<EOF
$info
EOF
  [ "$st" = OPEN ] || die "#$n is $st. List only the open PRs, with --after <the last merged one> before them."
  [ "$draft" = false ] || die "#$n is a draft. Mark it ready with: gh pr ready $n"
  fetch_pr "$n"
  if [ -z "$prev_pr" ]; then
    [ "$base" = "$trunk" ] || die "#$n targets $base, not $trunk. List the PRs below it too, lowest first."
    git merge-base --is-ancestor "origin/$trunk" "$head" ||
      die "#$n does not contain $trunk. Merge origin/$trunk into $branch, then merge each branch into the one above it, push them, and run again."
  else
    [ "$base" = "$prev_branch" ] || { [ "$prev_pr" = "$after" ] && [ "$base" = "$trunk" ]; } ||
      die "#$n targets $base, not #$prev_pr's branch $prev_branch. List every layer of the stack, lowest first."
    holds "$prev_head" "$head" ||
      die "#$n ($branch) does not hold #$prev_pr's head $prev_head, so landing it would undo #$prev_pr's newer commits. Merge $prev_head into $branch, then merge each branch into the one above it, push them, and run again."
  fi
  if [ -n "$dry" ]; then
    [ -z "$prev_pr" ] ||
      echo "would point #$n at $trunk, delete #$prev_pr's branch unless open PRs use it, and merge $trunk into $branch with -s ours"
    echo "would wait for #$n's checks, then squash #$n as \"$(field "$n" title) (#$n)\"${admin:+, with --admin if its checks never start}"
  fi
  prev_pr=$n prev_branch=$branch prev_head=$head
done
if [ -n "$dry" ]; then
  echo "would delete #$prev_pr's branch unless open PRs use it"
  echo 'Dry run: the stack checks passed; nothing changed.'
  exit 0
fi

# Waits until the PR is based on the default branch at the expected head, GitHub would merge it,
# and no reported check is pending or failing. An empty check list counts only from the third
# look, so checks that have not registered yet are not taken for passing.
# shellcheck disable=SC2016 # a jq program, not shell
ready_jq='[.statusCheckRollup[] | if .__typename == "StatusContext" then .state
    elif .status != "COMPLETED" then "PENDING" else .conclusion end] as $c
  | "\(.baseRefName) \(.headRefOid) \(.isDraft) \(.mergeable) \(.mergeStateStatus) \(
    if any($c[]; . == "PENDING" or . == "EXPECTED") then "pending"
    elif all($c[]; . == "SUCCESS" or . == "NEUTRAL" or . == "SKIPPED") | not then "failing"
    elif $c == [] then "none" else "passing" end)"'
# Writes unique failing-check annotations to $work/notes, read from every page. A failing run is a
# check run whose conclusion is not success, neutral, skipped or null. check_notes_unstarted is 1
# when there is a failing run and every failing run has at least one annotation, all starting with
# "The job was not started", and 0 otherwise.
check_notes() { # <pr>
  cn_head=$(field "$1" headRefOid)
  gh api "repos/{owner}/{repo}/commits/$cn_head/check-runs?per_page=100" --paginate \
    --jq '.check_runs[] | select(.conclusion != null and .conclusion != "success" and .conclusion != "neutral" and .conclusion != "skipped") | .id' >"$work/ids" || true
  : >"$work/notes"
  cn_runs=0 cn_unstarted=0 # failing runs, and those whose annotations all say not started
  while read -r cn_id; do
    [ -n "$cn_id" ] || continue
    cn_runs=$((cn_runs + 1))
    gh api "repos/{owner}/{repo}/check-runs/$cn_id/annotations?per_page=100" --paginate --jq '.[].message' >"$work/run-notes" || true
    cat "$work/run-notes" >>"$work/notes"
    [ -s "$work/run-notes" ] || continue
    cn_started=0
    while IFS= read -r cn_line; do
      case $cn_line in
      "The job was not started"*) ;;
      *) cn_started=1 ;;
      esac
    done <"$work/run-notes"
    [ "$cn_started" = 1 ] || cn_unstarted=$((cn_unstarted + 1))
  done <"$work/ids"
  check_notes_unstarted=0
  if [ "$cn_runs" -gt 0 ] && [ "$cn_unstarted" = "$cn_runs" ]; then check_notes_unstarted=1; fi
  awk 'NF && !seen[$0]++' "$work/notes" >"$work/notes.uniq"
  mv "$work/notes.uniq" "$work/notes"
}
# Prints the number of pending and of failing entries of statusCheckRollup (check runs and commit
# statuses), as ready_jq tells them apart, then every entry's name and result, so two reads can be
# compared.
# shellcheck disable=SC2016 # a jq program, not shell
rollup_jq='[.statusCheckRollup[] | if .__typename == "StatusContext" then [.context, .state]
    else [.name, .status, .conclusion] end] as $r
  | [$r[] | if length == 2 then .[1] elif .[1] != "COMPLETED" then "PENDING" else .[2] end] as $c
  | "\([$c[] | select(. == "PENDING" or . == "EXPECTED")] | length) \(
    [$c[] | select(. != "PENDING" and . != "EXPECTED" and . != "SUCCESS" and . != "NEUTRAL" and . != "SKIPPED")] | length) \(
    [$r[] | map(. // "") | join(":")] | sort | join(" "))"'
one_line() { tr '\n' ' ' <"$1" | sed 's/  */ /g; s/ *$//'; }
# Sets wr_admin to 1 when the PR merges with --admin: --admin-if-unstarted is on, every failing check
# is a check run that never started, and no review is required or asks for changes. --admin also
# skips a required review, so that review stops the run. Required checks that never started make
# GitHub report BLOCKED; --admin is for exactly that, so BLOCKED does not stop this path. --admin
# also merges past a check that has not registered yet, so the PR merges only when two reads in a
# row, $poll seconds apart, show the same checks and no pending one.
wait_ready() { # <pr> <head>
  wr_pr=$1 wr_i=0 wr_fails=0 wr_blocked=0 wr_admin='' wr_seen=''
  while :; do
    if wr_info=$(gh pr view "$wr_pr" --json baseRefName,headRefOid,isDraft,mergeable,mergeStateStatus,statusCheckRollup \
      --jq "$ready_jq"); then
      wr_fails=0 wr_prev=$wr_seen wr_seen=''
      read -r wr_base wr_head wr_draft wr_mergeable wr_state wr_checks <<EOF
$wr_info
EOF
      [ "$wr_head" = "$2" ] || die "#$wr_pr's head moved from $2 to $wr_head while it waited. Check that push, then run again."
      [ "$wr_base" = "$trunk" ] || die "#$wr_pr targets $wr_base, not $trunk."
      [ "$wr_draft" = false ] || die "#$wr_pr is a draft. Mark it ready with: gh pr ready $wr_pr"
      [ "$wr_mergeable" != CONFLICTING ] || die "#$wr_pr has conflicts with $trunk."
      if [ "$wr_checks" = failing ]; then
        gh pr checks "$wr_pr" >&2 || true
        check_notes "$wr_pr"
        cn_text=$(one_line "$work/notes")
        if [ "$check_notes_unstarted" = 1 ] && [ -n "$admin" ]; then
          wr_rollup=$(gh pr view "$wr_pr" --json statusCheckRollup --jq "$rollup_jq")
          wr_pending=${wr_rollup%% *} wr_failing=${wr_rollup#* }
          wr_failing=${wr_failing%% *}
          if [ "$wr_pending" = 0 ]; then # else a check registered since the first read: wait for it
            [ "$wr_failing" = "$cn_runs" ] ||
              die "#$wr_pr has $wr_failing failing checks; $cn_runs of them never started: $cn_text"
            wr_review=$(field "$wr_pr" reviewDecision)
            case $wr_review in
            REVIEW_REQUIRED | CHANGES_REQUESTED)
              die "#$wr_pr's checks never started, but #$wr_pr's review decision is $wr_review, and --admin would skip that review too. Get the review, then run again."
              ;;
            esac
            if [ "$wr_mergeable" = MERGEABLE ] && [ "$wr_rollup" = "$wr_prev" ]; then
              echo "#$wr_pr's checks never started: $cn_text. Merging #$wr_pr with --admin."
              wr_admin=1
              return 0
            fi
            wr_seen=$wr_rollup
          fi
        elif [ "$check_notes_unstarted" = 1 ]; then
          die "#$wr_pr's checks never started: $cn_text. The local check on this head is the evidence. This script does not clear required status checks."
        elif [ -n "$cn_text" ]; then
          die "#$wr_pr has failing checks: $cn_text"
        else
          die "#$wr_pr has failing checks."
        fi
      fi
      if [ "$wr_mergeable" = MERGEABLE ] && { [ "$wr_checks" = passing ] || { [ "$wr_checks" = none ] && [ "$wr_i" -ge 2 ]; }; }; then
        case $wr_state in
        CLEAN | HAS_HOOKS | UNSTABLE) return 0 ;;
        BLOCKED)
          wr_blocked=$((wr_blocked + 1))
          [ "$wr_blocked" -lt 3 ] ||
            die "#$wr_pr is BLOCKED with no check pending: it needs a review, or a rule blocks it. Clear that, then run again."
          ;;
        esac
      fi
    else
      wr_fails=$((wr_fails + 1))
      [ "$wr_fails" -lt 5 ] || die "gh failed 5 times in a row reading #$wr_pr."
      wr_info='(gh failed)'
    fi
    wr_i=$((wr_i + 1))
    [ "$wr_i" -le 120 ] || die "#$wr_pr was not ready after 120 checks, $poll seconds apart: $wr_info"
    sleep "$poll"
  done
}

# GitHub can report a PR's old head for a while after a push. Waits until it reports <head>.
wait_head() { # <pr> <head>
  wh_i=0
  while [ "$(field "$1" headRefOid)" != "$2" ]; do
    wh_i=$((wh_i + 1))
    [ "$wh_i" -lt 10 ] ||
      die "GitHub still reports #$1's old head after 10 checks, $poll seconds apart, though $2 was pushed. Check the PR, then run again."
    sleep "$poll"
  done
}

# Points <next pr> at the default branch, then deletes <landed pr>'s branch unless another open PR
# is based on it: deleting a branch closes the PRs based on it.
retire_branch() { # <landed pr> [<next pr>]
  rb_branch=$(field "$1" headRefName)
  if [ -n "${2:-}" ] && [ "$(field "$2" baseRefName)" != "$trunk" ]; then
    gh pr edit "$2" --base "$trunk" >/dev/null
  fi
  git ls-remote --exit-code origin "refs/heads/$rb_branch" >/dev/null || return 0 # deleted on merge
  rb_others=$(gh pr list --base "$rb_branch" --state open --json number --jq '.[].number' | tr '\n' ' ')
  if [ -n "$rb_others" ]; then
    echo "kept $rb_branch: open PRs $rb_others are based on it"
  else
    git push -q origin --delete "$rb_branch"
  fi
}

# Brings the default branch into the next PR's branch after the PR below it landed. It takes the
# branch's head from origin, since GitHub can still report the head from before a push this
# script made in a run that stopped.
merge_up() { # <landed pr> <landed head> <next pr>
  fetch_pr "$1"
  git fetch -q origin
  mu_branch=$(field "$3" headRefName)
  git fetch -q origin "+refs/heads/$mu_branch:refs/remotes/origin/$mu_branch" ||
    die "Could not fetch #$3's branch $mu_branch from origin."
  mu_head=$(git rev-parse "refs/remotes/origin/$mu_branch")
  holds "$2" "$mu_head" ||
    die "#$3 ($mu_branch) does not hold #$1's head $2, so landing it would undo #$1's newer commits. Merge $2 into $mu_branch, then merge each branch into the one above it, push them, and run again."
  retire_branch "$1" "$3"
  if ! same_tree "origin/$trunk" "$2"; then
    resume_after=''
    mu_squash=$(gh pr view "$1" --json mergeCommit --jq .mergeCommit.oid)
    same_tree "$mu_squash" "$2" ||
      die "#$1's squash on $trunk does not equal its head ($trunk moved before the squash). Merge origin/$trunk into $mu_branch normally and resolve, then merge each branch into the one above it, push them, and run again."
    merge_ours "$mu_branch" "$mu_head" "$mu_squash" "Merge #$1's squash into $mu_branch"
    die "$trunk gained commits after #$1 landed. $mu_branch now holds #$1's squash, so a normal merge of origin/$trunk into $mu_branch brings only those commits. Merge it, then merge each branch into the one above it, push them, and run again."
  fi
  merge_ours "$mu_branch" "$mu_head" "origin/$trunk" "Merge $trunk into $mu_branch after #$1 landed"
  echo "#$3 now holds $trunk ($(git rev-parse --short "$merged"))"
}

prev_pr=$after prev_head=''
[ -z "$after" ] || prev_head=$(field "$after" headRefOid)
# shellcheck disable=SC2086 # PR numbers, split on purpose
set -- $prs
while [ "$#" -gt 0 ]; do
  n=$1
  shift
  if [ -n "$prev_pr" ]; then
    merge_up "$prev_pr" "$prev_head" "$n"
    head=$merged
    wait_head "$n" "$head"
  else
    head=$(field "$n" headRefOid)
  fi
  echo "waiting for #$n's checks"
  wait_ready "$n" "$head"
  git fetch -q origin
  if ! git merge-base --is-ancestor "origin/$trunk" "$head"; then
    resume_after=''
    die "$trunk moved while #$n waited. Merge origin/$trunk into $(field "$n" headRefName), then merge each branch into the one above it, push them, and run again."
  fi
  if [ "$#" -gt 0 ]; then
    fetch_pr "$1"
    holds "$head" "$(field "$1" headRefOid)" ||
      die "#$1 no longer holds #$n's head $head. Merge $head into $(field "$1" headRefName), then merge each branch into the one above it, push them, and run again."
  fi
  if [ "$squash_msg" = BLANK ]; then
    gh pr merge "$n" --squash ${wr_admin:+--admin} --match-head-commit "$head"
  else
    gh pr view "$n" --json body --jq .body >"$work/body"
    gh pr merge "$n" --squash ${wr_admin:+--admin} --match-head-commit "$head" \
      --subject "$(field "$n" title) (#$n)" --body-file "$work/body"
  fi
  [ "$(field "$n" state)" = MERGED ] || die "#$n did not merge, though gh pr merge returned: $(field "$n" state)."
  last=$n todo=${todo# "$n"}
  git fetch -q origin
  echo "#$n landed as $(git rev-parse --short "origin/$trunk")"
  prev_pr=$n prev_head=$head
done
retire_branch "$prev_pr"
echo 'Done: every PR landed.'
